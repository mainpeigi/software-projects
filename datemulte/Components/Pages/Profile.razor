@page "/profile"
@inject LocalProfileService AuthService
@inject UserProfileService ProfileService
@inject ISnackbar Snackbar

<PageTitle>Local profile - Datemulte</PageTitle>
<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-3">Local profile</MudText>
        <MudText Class="mb-4">Your profile and saved sessions stay on this laptop. No account or password is required.</MudText>
        <MudTextField @bind-Value="displayName" Label="Display name" Variant="Variant.Outlined" />
        <MudButton OnClick="Save" Color="Color.Primary" Variant="Variant.Filled" Class="mt-4">Save profile</MudButton>
    </MudPaper>
</MudContainer>
@code {
    private string displayName = "Local user";
    protected override async Task OnInitializedAsync()
    {
        var profile = await ProfileService.GetOrCreateProfileAsync(AuthService.CurrentUserId!.Value, AuthService.GetUserEmail());
        displayName = profile.DisplayName ?? "Local user";
    }
    private async Task Save()
    {
        await ProfileService.UpdateProfileAsync(AuthService.CurrentUserId!.Value, displayName, null);
        Snackbar.Add("Profile saved on this laptop.", Severity.Success);
    }
}
