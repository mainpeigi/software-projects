    private MudBlazor.Utilities.MudColor SafeParseColor(string colorValue, string fallback)
    {
        if (string.IsNullOrEmpty(colorValue))
        {
            return new MudBlazor.Utilities.MudColor(fallback);
        }

        if (colorValue.Equals("transparent", StringComparison.OrdinalIgnoreCase) ||
            colorValue.Equals("none", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                var baseColor = new MudBlazor.Utilities.MudColor(fallback);
                return new MudBlazor.Utilities.MudColor((byte)baseColor.R, (byte)baseColor.G, (byte)baseColor.B, (byte)0);
            }
            catch
            {
                return new MudBlazor.Utilities.MudColor((byte)255, (byte)255, (byte)255, (byte)0);
            }
        }

        if (colorValue.StartsWith("rgba", StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                var mudColor = new MudBlazor.Utilities.MudColor(colorValue);
                if (mudColor.A <= 1)
                {
                    return mudColor;
                }
                return mudColor;
            }
            catch
            {
                return new MudBlazor.Utilities.MudColor(fallback);
            }
        }

        try
        {
            return new MudBlazor.Utilities.MudColor(colorValue);
        }
        catch
        {
            return new MudBlazor.Utilities.MudColor(fallback);
        }
    }

    private string ColorToString(MudBlazor.Utilities.MudColor color)
    {
        if (color.A <= 1)
        {
            return "transparent";
        }

        if (color.A < 255)
        {
            double alpha = Math.Round(color.A / 255.0, 2);
            return $"rgba({color.R}, {color.G}, {color.B}, {alpha})";
        }

        return color.Value;
    }

