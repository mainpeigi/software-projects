private void UpdateCustomColor(int index, MudBlazor.Utilities.MudColor value)
{
    var colorStr = ColorToString(value);
    var newList = (CustomColors ?? new List<string>()).ToList();
    
    while (newList.Count <= index)
    {
        newList.Add("#5470c6");
    }
    
    newList[index] = colorStr;
    CustomColors = newList;
    CustomColorsChanged.InvokeAsync(newList);
}
