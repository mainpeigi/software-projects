@using Datemulte_2.Services

<MudPaper Elevation="4" Class="pa-3" Style="background-color: #1e293b;">
    <MudText Typo="Typo.subtitle1" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /> Chart Customization
    </MudText>

    <div style="max-height: 450px; overflow-y: auto; overflow-x: hidden;">
    <MudExpansionPanels MultiExpansion="false" Elevation="0" Dense="true" Style="background-color: #1e293b;">

        <!-- ========== APPEARANCE GROUP ========== -->
        <MudExpansionPanel Text="Appearance" Icon="@Icons.Material.Filled.Palette" Dense="true" Style="background-color: #1e293b;">
            <MudExpansionPanels MultiExpansion="true" Dense="true" Class="pl-2" Style="background-color: #1e293b;">

                <!-- Colors -->
                <MudExpansionPanel Text="Colors" Icon="@Icons.Material.Filled.ColorLens" Dense="true" Style="background-color: #1e293b;">
                    <MudSelect Value="ColorPalette" ValueChanged="(string v) => { ColorPalette = v; ColorPaletteChanged.InvokeAsync(v); }" Label="Color Palette" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                        <MudSelectItem Value="@("default")">Default</MudSelectItem>
                        <MudSelectItem Value="@("cool")">Cool</MudSelectItem>
                        <MudSelectItem Value="@("warm")">Warm</MudSelectItem>
                        <MudSelectItem Value="@("vibrant")">Vibrant</MudSelectItem>
                        <MudSelectItem Value="@("pastel")">Pastel</MudSelectItem>
                        <MudSelectItem Value="@("custom")">Custom</MudSelectItem>
                    </MudSelect>
                    <MudText Typo="Typo.subtitle2" Class="mb-2"><strong>Background Colors</strong></MudText>
                    @if (ColorPalette == "custom")
                    {
                        <MudDivider Class="mb-3"/>
                        <MudText Typo="Typo.subtitle2" Class="mb-2"><strong>Custom Line Colors</strong></MudText>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                            <MudColorPicker @bind-Value="@customColor1Mud" Label="Line 1" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                            <MudColorPicker @bind-Value="@customColor2Mud" Label="Line 2" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                            <MudColorPicker @bind-Value="@customColor3Mud" Label="Line 3" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                            <MudColorPicker @bind-Value="@customColor4Mud" Label="Line 4" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                            <MudColorPicker @bind-Value="@customColor5Mud" Label="Line 5" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                            <MudColorPicker @bind-Value="@customColor6Mud" Label="Line 6" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                            <MudColorPicker @bind-Value="@customColor7Mud" Label="Line 7" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                            <MudColorPicker @bind-Value="@customColor8Mud" Label="Line 8" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB"/>
                        </div>
                    }
                    <MudColorPicker @bind-Value="@chartBgColorMud" Label="Chart Background" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
                    <MudColorPicker @bind-Value="@gridBgColorMud" Label="Plot Area Background" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
            
                </MudExpansionPanel>
                <!-- Chart Type -->
                <MudExpansionPanel Text="Chart Type" Icon="@Icons.Material.Filled.BarChart" Dense="true" Style="background-color: #1e293b">
                    <MudSelect Value="ChartType" ValueChanged="(string v) => { ChartType = v; ChartTypeChanged.InvokeAsync(v); }" Label="Chart Type" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                        <MudSelectItem Value="@("line")">Line</MudSelectItem>
                        <MudSelectItem Value="@("area")">Area</MudSelectItem>
                        <MudSelectItem Value="@("stepLine")">Step Line</MudSelectItem>
                        <MudSelectItem Value="@("stepArea")">Step Area</MudSelectItem>
                        <MudSelectItem Value="@("bar")">Bar</MudSelectItem>
                        <MudSelectItem Value="@("stackedBar")">Stacked Bar</MudSelectItem>
                        <MudSelectItem Value="@("stackedArea")">Stacked Area</MudSelectItem>
                        <MudSelectItem Value="@("scatter")">Scatter</MudSelectItem>
                        <MudSelectItem Value="@("pie")">Pie</MudSelectItem>
                        <MudSelectItem Value="@("radar")">Radar</MudSelectItem>
                        <MudSelectItem Value="@("candlestick")">Candlestick</MudSelectItem>
                        <MudSelectItem Value="@("heatmap")">Heatmap</MudSelectItem>
                        <MudSelectItem Value="@("donut")">Donut</MudSelectItem>
                        <MudSelectItem Value="@("rose")">Rose</MudSelectItem>
                        <MudSelectItem Value="@("waterfall")">Waterfall</MudSelectItem>
                        <MudSelectItem Value="@("barRacing")">Bar Racing</MudSelectItem>
                        
                    </MudSelect>
                </MudExpansionPanel>
                <!-- Line Style -->
                <MudExpansionPanel Text="Line Style" Icon="@Icons.Material.Filled.ShowChart" Dense="true" Style="background-color: #1e293b;">
                    <MudSelect Value="LineStyle" ValueChanged="(string v) => { LineStyle = v; LineStyleChanged.InvokeAsync(v); }" Label="Line Style" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                        <MudSelectItem Value="@("solid")">Solid</MudSelectItem>
                        <MudSelectItem Value="@("dashed")">Dashed</MudSelectItem>
                        <MudSelectItem Value="@("dotted")">Dotted</MudSelectItem>
                    </MudSelect>
                    <MudSlider Value="LineOpacity" ValueChanged="(int v) => { LineOpacity = v; LineOpacityChanged.InvokeAsync(v); }" Min="0" Max="100" Step="10" Color="Color.Primary" Class="mb-2">
                        Line Opacity: @LineOpacity%
                    </MudSlider>
                    <MudSlider Value="AreaOpacity" ValueChanged="(int v) => { AreaOpacity = v; AreaOpacityChanged.InvokeAsync(v); }" Min="0" Max="100" Step="10" Color="Color.Primary" Class="mb-2">
                        Area Opacity: @AreaOpacity%
                    </MudSlider>
                    <MudSwitch T="bool" Value="EnableSmoothLines" ValueChanged="(bool v) => { EnableSmoothLines = v; EnableSmoothLinesChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Smooth Curves" />
                </MudExpansionPanel>

            </MudExpansionPanels>
        </MudExpansionPanel>

        <!-- ========== DATA DISPLAY GROUP ========== -->
        <MudExpansionPanel Text="Data Display" Icon="@Icons.Material.Filled.DataArray" Dense="true" Style="background-color: #1e293b;">
            <MudExpansionPanels MultiExpansion="true" Dense="true" Class="pl-2" Style="background-color: #1e293b;">

                <!-- Markers -->
                <MudExpansionPanel Text="Markers" Icon="@Icons.Material.Filled.Circle" Dense="true" Style="background-color: #1e293b;">
            <MudSwitch T="bool" 
                       Value="ShowDataPointMarkers" 
                       ValueChanged="@((bool v) => { ShowDataPointMarkers = v; ShowDataPointMarkersChanged.InvokeAsync(v); })"
                       Color="Color.Primary" 
                       Label="Show Markers on All Points" 
                       Class="mb-3" />
            <MudSelect Value="SymbolType" ValueChanged="(string v) => { SymbolType = v; SymbolTypeChanged.InvokeAsync(v); }" Label="Symbol Type" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                <MudSelectItem Value="@("circle")">Circle</MudSelectItem>
                <MudSelectItem Value="@("rect")">Rectangle</MudSelectItem>
                <MudSelectItem Value="@("roundRect")">Rounded Rectangle</MudSelectItem>
                <MudSelectItem Value="@("triangle")">Triangle</MudSelectItem>
                <MudSelectItem Value="@("diamond")">Diamond</MudSelectItem>
                <MudSelectItem Value="@("pin")">Pin</MudSelectItem>
                <MudSelectItem Value="@("arrow")">Arrow</MudSelectItem>
                <MudSelectItem Value="@("none")">None (Hide Markers)</MudSelectItem>
            </MudSelect>
            <MudNumericField Value="SymbolSize" ValueChanged="(int v) => { SymbolSize = v; SymbolSizeChanged.InvokeAsync(v); }" Label="Symbol Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="2" Max="30" />
                </MudExpansionPanel>

                <!-- Data Labels -->
                <MudExpansionPanel Text="Data Labels" Icon="@Icons.Material.Filled.Label" Dense="true" Style="background-color: #1e293b;">
            <MudSwitch T="bool" Value="ShowDataLabels" ValueChanged="(bool v) => { ShowDataLabels = v; ShowDataLabelsChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Show Data Labels" Class="mb-2" />
            @if (ShowDataLabels)
            {
                <MudSelect Value="DataLabelPosition" ValueChanged="(string v) => { DataLabelPosition = v; DataLabelPositionChanged.InvokeAsync(v); }" Label="Position" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                    <MudSelectItem Value="@("top")">Top</MudSelectItem>
                    <MudSelectItem Value="@("inside")">Inside</MudSelectItem>
                    <MudSelectItem Value="@("insideTop")">Inside Top</MudSelectItem>
                    <MudSelectItem Value="@("bottom")">Bottom</MudSelectItem>
                    <MudSelectItem Value="@("left")">Left</MudSelectItem>
                    <MudSelectItem Value="@("right")">Right</MudSelectItem>
                </MudSelect>
                        <MudColorPicker @bind-Value="@dataLabelColorMud" Label="Label Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
                <MudNumericField Value="DataLabelFontSize" ValueChanged="(int v) => { DataLabelFontSize = v; DataLabelFontSizeChanged.InvokeAsync(v); }" Label="Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
                <MudSelect Value="DataLabelFontWeight" ValueChanged="(string v) => { DataLabelFontWeight = v; DataLabelFontWeightChanged.InvokeAsync(v); }" Label="Font Weight" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                    <MudSelectItem Value="@("normal")">Normal</MudSelectItem>
                    <MudSelectItem Value="@("bold")">Bold</MudSelectItem>
                    <MudSelectItem Value="@("bolder")">Bolder</MudSelectItem>
                    <MudSelectItem Value="@("lighter")">Lighter</MudSelectItem>
                </MudSelect>
                        <MudColorPicker @bind-Value="@dataLabelBackgroundColorMud" Label="Background Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
                        <MudColorPicker @bind-Value="@dataLabelBorderColorMud" Label="Border Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
                <MudNumericField Value="DataLabelBorderWidth" ValueChanged="(int v) => { DataLabelBorderWidth = v; DataLabelBorderWidthChanged.InvokeAsync(v); }" Label="Border Width" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="5" Class="mb-2" />
                <MudNumericField Value="DataLabelBorderRadius" ValueChanged="(int v) => { DataLabelBorderRadius = v; DataLabelBorderRadiusChanged.InvokeAsync(v); }" Label="Border Radius" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="10" Class="mb-2" />
                <MudNumericField Value="DataLabelPadding" ValueChanged="(int v) => { DataLabelPadding = v; DataLabelPaddingChanged.InvokeAsync(v); }" Label="Padding" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20" Class="mb-2" />
                <MudTextField Value="DataLabelFormatter" ValueChanged="(string v) => { DataLabelFormatter = v; DataLabelFormatterChanged.InvokeAsync(v); }" Label="Formatter (e.g., {c})" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudNumericField Value="DataLabelRotate" ValueChanged="(int v) => { DataLabelRotate = v; DataLabelRotateChanged.InvokeAsync(v); }" Label="Rotation (degrees)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="-90" Max="90" Class="mb-2" />
                <MudSwitch T="bool" Value="DataLabelShowOnHighlight" ValueChanged="(bool v) => { DataLabelShowOnHighlight = v; DataLabelShowOnHighlightChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Show Only on Highlight" />
            }
                </MudExpansionPanel>

                <!-- Legend -->
                <MudExpansionPanel Text="Legend" Icon="@Icons.Material.Filled.ViewList" Dense="true" Style="background-color: #1e293b;">
            <MudSwitch T="bool" Value="ShowLegend" ValueChanged="(bool v) => { ShowLegend = v; ShowLegendChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Show Legend" Class="mb-2" />
            @if (ShowLegend)
            {
                <MudSelect Value="LegendPosition" ValueChanged="(string v) => { LegendPosition = v; LegendPositionChanged.InvokeAsync(v); }" Label="Position" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                    <MudSelectItem Value="@("top")">Top</MudSelectItem>
                    <MudSelectItem Value="@("bottom")">Bottom</MudSelectItem>
                    <MudSelectItem Value="@("left")">Left</MudSelectItem>
                    <MudSelectItem Value="@("right")">Right</MudSelectItem>
                </MudSelect>
                <MudSelect Value="LegendOrient" ValueChanged="(string v) => { LegendOrient = v; LegendOrientChanged.InvokeAsync(v); }" Label="Orientation" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                    <MudSelectItem Value="@("horizontal")">Horizontal</MudSelectItem>
                    <MudSelectItem Value="@("vertical")">Vertical</MudSelectItem>
                </MudSelect>
                <MudNumericField Value="LegendFontSize" ValueChanged="(int v) => { LegendFontSize = v; LegendFontSizeChanged.InvokeAsync(v); }" Label="Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
                        <MudColorPicker @bind-Value="@legendTextColorMud" Label="Text Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
                        <MudColorPicker @bind-Value="@legendBackgroundColorMud" Label="Background Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
                        <MudColorPicker @bind-Value="@legendBorderColorMud" Label="Border Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
                <MudNumericField Value="LegendBorderWidth" ValueChanged="(int v) => { LegendBorderWidth = v; LegendBorderWidthChanged.InvokeAsync(v); }" Label="Border Width" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="5" Class="mb-2" />
                <MudNumericField Value="LegendBorderRadius" ValueChanged="(int v) => { LegendBorderRadius = v; LegendBorderRadiusChanged.InvokeAsync(v); }" Label="Border Radius" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20" Class="mb-2" />
                <MudNumericField Value="LegendPadding" ValueChanged="(int v) => { LegendPadding = v; LegendPaddingChanged.InvokeAsync(v); }" Label="Padding" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20" Class="mb-2" />
                <MudNumericField Value="LegendItemGap" ValueChanged="(int v) => { LegendItemGap = v; LegendItemGapChanged.InvokeAsync(v); }" Label="Item Gap" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="50" />
            }
                </MudExpansionPanel>

            </MudExpansionPanels>
        </MudExpansionPanel>

        <!-- ========== AXES & GRID GROUP ========== -->
        <MudExpansionPanel Text="Axes & Grid" Icon="@Icons.Material.Filled.GridOn" Dense="true" Style="background-color: #1e293b;">
            <MudExpansionPanels MultiExpansion="true" Dense="true" Class="pl-2" Style="background-color: #1e293b;">
                <!-- X-Axis -->
                <MudExpansionPanel Text="X-Axis" Icon="@Icons.Material.Filled.HorizontalRule" Dense="true" Style="background-color: #1e293b;">
                @if (ChartLayout == "horizontal" || ChartLayout == "vertical")
                {
                    <MudSelect T="string" @bind-Value="SelectedChartForAxisEdit" Label="Edit Chart" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                        <MudSelectItem Value="@("chart1")">Chart 1</MudSelectItem>
                        <MudSelectItem Value="@("chart2")">Chart 2</MudSelectItem>
                        <MudSelectItem Value="@("chart3")">Chart 3</MudSelectItem>
                        <MudSelectItem Value="@("chart4")">Chart 4</MudSelectItem>
                        <MudSelectItem Value="@("chart5")">Chart 5</MudSelectItem>
                        <MudSelectItem Value="@("chart6")">Chart 6</MudSelectItem>
                        <MudSelectItem Value="@("chart7")">Chart 7</MudSelectItem>
                        <MudSelectItem Value="@("chart8")">Chart 8</MudSelectItem>
                    </MudSelect>
                }
            <MudTextField Value="XAxisName" ValueChanged="(string v) => HandleXAxisNameChangeImmediate(v)" Label="Axis Label" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="false" />
            <MudSelect Value="XAxisNameLocation" ValueChanged="(string v) => { XAxisNameLocation = v; XAxisNameLocationChanged.InvokeAsync(v); }" Label="Label Location" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                <MudSelectItem Value="@("start")">Start</MudSelectItem>
                <MudSelectItem Value="@("middle")">Middle</MudSelectItem>
                <MudSelectItem Value="@("end")">End</MudSelectItem>
            </MudSelect>
            <MudNumericField Value="XAxisNameGap" ValueChanged="(int v) => { XAxisNameGap = v; XAxisNameGapChanged.InvokeAsync(v); }" Label="Label Gap" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Class="mb-2" />
            <MudNumericField Value="XAxisNameFontSize" ValueChanged="(int v) => { XAxisNameFontSize = v; XAxisNameFontSizeChanged.InvokeAsync(v); }" Label="Axis Name Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
                    <MudColorPicker @bind-Value="@xAxisNameColorMud" Label="Axis Name Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
            <MudNumericField Value="XAxisLabelFontSize" ValueChanged="(int v) => { XAxisLabelFontSize = v; XAxisLabelFontSizeChanged.InvokeAsync(v); }" Label="Label Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
                    <MudColorPicker @bind-Value="@xAxisLabelColorMud" Label="Label Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
            <MudNumericField Value="XAxisLabelRotate" ValueChanged="(int v) => { XAxisLabelRotate = v; XAxisLabelRotateChanged.InvokeAsync(v); }" Label="Label Rotation" Variant="Variant.Outlined" Margin="Margin.Dense" Min="-90" Max="90" Class="mb-2" />
            <MudNumericField Value="XAxisLabelMargin" ValueChanged="(int v) => { XAxisLabelMargin = v; XAxisLabelMarginChanged.InvokeAsync(v); }" Label="Label Margin" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="50" Class="mb-2" />
            <MudSwitch T="bool" Value="XAxisShowTick" ValueChanged="(bool v) => { XAxisShowTick = v; XAxisShowTickChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Show Tick Marks" Class="mb-2" />
            <MudNumericField Value="XAxisTickLength" ValueChanged="(int v) => { XAxisTickLength = v; XAxisTickLengthChanged.InvokeAsync(v); }" Label="Tick Length" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20" Class="mb-2" />
                    <MudColorPicker @bind-Value="@xAxisTickColorMud" Label="Tick Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" />
                </MudExpansionPanel>

                <!-- Y-Axis -->
                <MudExpansionPanel Text="Y-Axis" Icon="@Icons.Material.Filled.VerticalAlignCenter" Dense="true" Style="background-color: #1e293b;">
            @if (ChartLayout == "horizontal" || ChartLayout == "vertical")
            {
                <MudSelect T="string" @bind-Value="SelectedChartForAxisEdit" Label="Edit Chart" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    <MudSelectItem Value="@("chart1")">Chart 1</MudSelectItem>
                    <MudSelectItem Value="@("chart2")">Chart 2</MudSelectItem>
                    <MudSelectItem Value="@("chart3")">Chart 3</MudSelectItem>
                    <MudSelectItem Value="@("chart4")">Chart 4</MudSelectItem>
                    <MudSelectItem Value="@("chart5")">Chart 5</MudSelectItem>
                    <MudSelectItem Value="@("chart6")">Chart 6</MudSelectItem>
                    <MudSelectItem Value="@("chart7")">Chart 7</MudSelectItem>
                    <MudSelectItem Value="@("chart8")">Chart 8</MudSelectItem>
                </MudSelect>
            }
            <MudTextField Value="YAxisName" ValueChanged="(string v) => HandleYAxisNameChangeImmediate(v)" Label="Axis Label" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="false" />
            <MudSelect Value="YAxisNameLocation" ValueChanged="(string v) => { YAxisNameLocation = v; YAxisNameLocationChanged.InvokeAsync(v); }" Label="Label Location" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2">
                <MudSelectItem Value="@("start")">Start</MudSelectItem>
                <MudSelectItem Value="@("middle")">Middle</MudSelectItem>
                <MudSelectItem Value="@("end")">End</MudSelectItem>
            </MudSelect>
            <MudNumericField Value="YAxisNameGap" ValueChanged="(int v) => { YAxisNameGap = v; YAxisNameGapChanged.InvokeAsync(v); }" Label="Label Gap" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="100" Class="mb-2" />
            <MudNumericField Value="YAxisNameFontSize" ValueChanged="(int v) => { YAxisNameFontSize = v; YAxisNameFontSizeChanged.InvokeAsync(v); }" Label="Axis Name Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
                    <MudColorPicker @bind-Value="@yAxisNameColorMud" Label="Axis Name Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
            <MudNumericField Value="YAxisLabelFontSize" ValueChanged="(int v) => { YAxisLabelFontSize = v; YAxisLabelFontSizeChanged.InvokeAsync(v); }" Label="Label Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
                    <MudColorPicker @bind-Value="@yAxisLabelColorMud" Label="Label Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
            <MudSwitch T="bool" Value="YAxisAutoScale" ValueChanged="(bool v) => { YAxisAutoScale = v; YAxisAutoScaleChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Auto Scale" Class="mb-2" />
            @if (!YAxisAutoScale)
            {
                <MudNumericField Value="YAxisMin" ValueChanged="(int v) => { YAxisMin = v; YAxisMinChanged.InvokeAsync(v); }" Label="Minimum" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudNumericField Value="YAxisMax" ValueChanged="(int v) => { YAxisMax = v; YAxisMaxChanged.InvokeAsync(v); }" Label="Maximum" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
            }
            <MudSwitch T="bool" Value="YAxisShowTick" ValueChanged="(bool v) => { YAxisShowTick = v; YAxisShowTickChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Show Tick Marks" Class="mb-2" />
            <MudNumericField Value="YAxisTickLength" ValueChanged="(int v) => { YAxisTickLength = v; YAxisTickLengthChanged.InvokeAsync(v); }" Label="Tick Length" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="20" Class="mb-2" />
                    <MudColorPicker @bind-Value="@yAxisTickColorMud" Label="Tick Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
            <MudSwitch T="bool" Value="UseLogScale" ValueChanged="(bool v) => { UseLogScale = v; UseLogScaleChanged.InvokeAsync(v); }" Color="Color.Primary" Label="Logarithmic Scale" />
                </MudExpansionPanel>

                <!-- Y2-Axis -->
                <MudExpansionPanel Text="Y2-Axis (Secondary)" Icon="@Icons.Material.Filled.VerticalAlignTop" Dense="true" Style="background-color: #1e293b;">
            @if (ChartLayout == "horizontal" || ChartLayout == "vertical")
            {
                <MudSelect T="string" @bind-Value="SelectedChartForAxisEdit" Label="Edit Chart" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    <MudSelectItem Value="@("chart1")">Chart 1</MudSelectItem>
                    <MudSelectItem Value="@("chart2")">Chart 2</MudSelectItem>
                    <MudSelectItem Value="@("chart3")">Chart 3</MudSelectItem>
                    <MudSelectItem Value="@("chart4")">Chart 4</MudSelectItem>
                    <MudSelectItem Value="@("chart5")">Chart 5</MudSelectItem>
                    <MudSelectItem Value="@("chart6")">Chart 6</MudSelectItem>
                    <MudSelectItem Value="@("chart7")">Chart 7</MudSelectItem>
                    <MudSelectItem Value="@("chart8")">Chart 8</MudSelectItem>
                </MudSelect>
            }
            <MudTextField Value="Y2AxisName" ValueChanged="(string v) => HandleY2AxisNameChangeImmediate(v)" Label="Axis Label" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" Immediate="false" />
            <MudNumericField Value="Y2AxisNameFontSize" ValueChanged="(int v) => { Y2AxisNameFontSize = v; Y2AxisNameFontSizeChanged.InvokeAsync(v); }" Label="Axis Name Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
                    <MudColorPicker @bind-Value="@y2AxisNameColorMud" Label="Axis Name Color" Variant="Variant.Outlined" ColorPickerMode="ColorPickerMode.RGB" Class="mb-2" />
            <MudNumericField Value="Y2AxisLabelFontSize" ValueChanged="(int v) => { Y2AxisLabelFontSize = v; Y2AxisLabelFontSizeChanged.InvokeAsync(v); }" Label="Label Font Size" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="24" Class="mb-2" />
