                    }
                },
            animation = true,
            animationDuration = animationDuration,
            animationEasing = animationEasing,
            animationDurationUpdate = animationDuration,
            animationEasingUpdate = animationEasing,
            series = series.ToArray()
        };

        var jsonOptions = new System.Text.Json.JsonSerializerOptions
        {
            NumberHandling = System.Text.Json.Serialization.JsonNumberHandling.AllowNamedFloatingPointLiterals
        };

        var jsonString = System.Text.Json.JsonSerializer.Serialize(option, jsonOptions);

        var themeParam = chartTheme == "default" ? "null" : $"'{chartTheme}'";

        // Build array of which charts should sync
        var syncCharts = new List<int>();
        if (zoomSyncAllCharts)
        {
            // If "Sync All Charts" is checked, add all possible charts
            for (int i = 1; i <= 8; i++)
            {
                syncCharts.Add(i);
