    private object BuildPieChartOption(List<string> columns, List<string> colors)
    {
        var sampledData = GetSampledData();
        var pieData = new List<object>();
        foreach (var column in columns)
        {
            double sum = 0;
            int count = 0;
            foreach (var row in sampledData)
            {
                var val = row.GetNumericValueOrNull(column);
                if (val != null && val is double d) { sum += d; count++; }
            }
            pieData.Add(new { name = column, value = Math.Round(sum, decimalPlaces) });
        }

        return new
        {
            title = showTitle ? new { text = titleText, left = titleAlignment, top = titleTop, textStyle = new { color = titleColor, fontSize = titleFontSize, fontWeight = titleFontWeight } } : null,
            tooltip = new { trigger = "item", formatter = "{b}: {c} ({d}%)" },
            legend = showLegend ? new { orient = legendOrient, left = "center", top = legendPosition == "bottom" ? "bottom" : "top", textStyle = new { color = legendTextColor } } : null,
            color = colors,
            series = new[] {
                new {
                    type = "pie",
                    radius = "60%",
                    center = new[] { "50%", "55%" },
                    data = pieData,
                    emphasis = new { itemStyle = new { shadowBlur = 10, shadowOffsetX = 0, shadowColor = "rgba(0, 0, 0, 0.5)" } },
                    label = new { color = titleColor }
                }
            }
        };
    }

    private object BuildRadarChartOption(List<string> columns, List<string> colors)
    {
        var sampledData = GetSampledData();
        var indicator = columns.Select(col => {
            double max = 0;
            foreach (var row in sampledData)
            {
                var val = row.GetNumericValueOrNull(col);
                if (val != null && val is double d && d > max) max = d;
            }
            return new { name = col, max = max > 0 ? max * 1.1 : 100 };
        }).ToArray();

        var radarData = new List<double>();
        foreach (var column in columns)
        {
            double sum = 0; int count = 0;
            foreach (var row in sampledData)
            {
                var val = row.GetNumericValueOrNull(column);
                if (val != null && val is double d) { sum += d; count++; }
            }
            radarData.Add(count > 0 ? Math.Round(sum / count, decimalPlaces) : 0);
        }

        return new
        {
            title = showTitle ? new { text = titleText, left = titleAlignment, top = titleTop, textStyle = new { color = titleColor, fontSize = titleFontSize, fontWeight = titleFontWeight } } : null,
            tooltip = new { trigger = "item" },
            legend = showLegend ? new { top = legendPosition == "bottom" ? "bottom" : "top", textStyle = new { color = legendTextColor } } : null,
            color = colors,
            radar = new { indicator = indicator, axisName = new { color = xAxisLabelColor }, splitLine = new { lineStyle = new { color = gridLineColor } }, splitArea = new { areaStyle = new { color = new[] { "transparent", "rgba(100,100,100,0.1)" } } } },
            series = new[] {
                new {
                    type = "radar",
                    data = new[] { new { value = radarData, name = "Average Values", areaStyle = new { opacity = 0.3 } } }
                }
            }
        };
    }

    private object BuildHeatmapChartOption(List<string> columns, List<string> colors)
    {
        var sampledData = GetSampledData();
        var heatmapData = new List<object[]>();
        double minVal = double.MaxValue, maxVal = double.MinValue;

        for (int row = 0; row < Math.Min(sampledData.Count, 50); row++)
        {
            for (int col = 0; col < columns.Count; col++)
            {
                var value = sampledData[row].GetNumericValueOrNull(columns[col]);
                if (value != null && value is double d)
                {
                    heatmapData.Add(new object[] { col, row, Math.Round(d, decimalPlaces) });
                    if (d < minVal) minVal = d;
                    if (d > maxVal) maxVal = d;
                }
            }
        }

        return new
        {
            title = showTitle ? new { text = titleText, left = titleAlignment, top = titleTop, textStyle = new { color = titleColor, fontSize = titleFontSize, fontWeight = titleFontWeight } } : null,
            tooltip = new { position = "top" },
            grid = new { left = gridLeft, right = gridRight + 60, bottom = gridBottom, top = gridTop, containLabel = true },
            xAxis = new { type = "category", data = columns, axisLabel = new { color = xAxisLabelColor, rotate = xAxisLabelRotate }, splitArea = new { show = true } },
            yAxis = new { type = "category", data = Enumerable.Range(0, Math.Min(sampledData.Count, 50)).Select(i => $"Row {i + 1}").ToArray(), axisLabel = new { color = yAxisLabelColor } },
            visualMap = new { min = minVal == double.MaxValue ? 0 : minVal, max = maxVal == double.MinValue ? 100 : maxVal, calculable = true, orient = "vertical", right = 10, top = "center", inRange = new { color = new[] { "#313695", "#4575b4", "#74add1", "#abd9e9", "#e0f3f8", "#ffffbf", "#fee090", "#fdae61", "#f46d43", "#d73027", "#a50026" } }, textStyle = new { color = titleColor } },
            series = new[] {
                new {
                    type = "heatmap",
                    data = heatmapData,
                    label = new { show = false },
                    emphasis = new { itemStyle = new { shadowBlur = 10, shadowColor = "rgba(0, 0, 0, 0.5)" } }
                }
            }
        };
    }

    private object? BuildCandlestickChartOption(List<string> columns, List<string> colors)
    {
        // Candlestick requires Open, High, Low, Close columns
        var openCol = columns.FirstOrDefault(c => c.ToLower().Contains("open"));
        var highCol = columns.FirstOrDefault(c => c.ToLower().Contains("high"));
        var lowCol = columns.FirstOrDefault(c => c.ToLower().Contains("low"));
        var closeCol = columns.FirstOrDefault(c => c.ToLower().Contains("close"));

        if (openCol == null || highCol == null || lowCol == null || closeCol == null)
        {
            // Fall back to using first 4 columns if OHLC not found
            if (columns.Count >= 4)
            {
                openCol = columns[0];
                highCol = columns[1];
                lowCol = columns[2];
                closeCol = columns[3];
            }
            else
            {
                return null; // Not enough columns for candlestick
            }
        }

        var sampledData = GetSampledData();
        var candleData = new List<double[]>();

        // Generate xAxis labels
        List<string> xAxisData;
        if (!string.IsNullOrEmpty(timeColumn))
        {
            xAxisData = sampledData.Select(d => {
                var timeValue = d.GetValue(timeColumn) ?? "";
                return CsvService.FormatTimeToMinutesSeconds(timeValue);
            }).ToList();
        }
        else
        {
            xAxisData = Enumerable.Range(1, sampledData.Count).Select(i => i.ToString()).ToList();
        }

        for (int i = 0; i < sampledData.Count; i++)
        {
            var openVal = sampledData[i].GetNumericValueOrNull(openCol);
            var closeVal = sampledData[i].GetNumericValueOrNull(closeCol);
            var lowVal = sampledData[i].GetNumericValueOrNull(lowCol);
            var highVal = sampledData[i].GetNumericValueOrNull(highCol);

            var open = openVal is double od ? od : 0;
            var close = closeVal is double cd ? cd : 0;
            var low = lowVal is double ld ? ld : 0;
            var high = highVal is double hd ? hd : 0;

            candleData.Add(new[] { open, close, low, high });
        }

        return new
        {
            title = showTitle ? new { text = titleText, left = titleAlignment, top = titleTop, textStyle = new { color = titleColor, fontSize = titleFontSize, fontWeight = titleFontWeight } } : null,
            tooltip = new { trigger = "axis", axisPointer = new { type = "cross" } },
            legend = showLegend ? new { data = new[] { "Candlestick" }, top = legendPosition == "bottom" ? "bottom" : "top", textStyle = new { color = legendTextColor } } : null,
            grid = new { left = gridLeft, right = gridRight, bottom = gridBottom + 40, top = gridTop, containLabel = true },
            xAxis = new { type = "category", data = xAxisData, axisLabel = new { color = xAxisLabelColor, rotate = xAxisLabelRotate }, axisLine = new { lineStyle = new { color = axisLineColor } } },
            yAxis = new { type = "value", scale = true, axisLabel = new { color = yAxisLabelColor }, splitLine = new { lineStyle = new { color = gridLineColor } } },
            dataZoom = showDataZoomSlider ? new object[] { new { type = "inside", start = 0, end = 100 }, new { type = "slider", start = 0, end = 100, bottom = 10, height = dataZoomHeight } } : null,
            series = new[] {
                new {
                    type = "candlestick",
                    data = candleData,
                    itemStyle = new { color = "#26a69a", color0 = "#ef5350", borderColor = "#26a69a", borderColor0 = "#ef5350" }
                }
            }
        };
    }

