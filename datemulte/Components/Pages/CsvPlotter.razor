    private async Task CheckForZeroValuesAsync()
    {
        Console.WriteLine($"CheckForZeroValuesAsync called. Data count: {data.Count}, Numeric columns: {numericColumns.Count}");

        if (data.Count == 0 || numericColumns.Count == 0)
        {
            Console.WriteLine("Skipping zero detection: no data or no numeric columns");
            return;
        }

        // Run detection in background to avoid blocking UI
        await Task.Run(() =>
        {
            zeroDetectionResult = CsvService.DetectZeroValues(data, numericColumns);
        });

        Console.WriteLine($"Zero detection complete. HasZeros: {zeroDetectionResult?.HasZeros}");

        if (zeroDetectionResult?.HasZeros == true)
        {
            Console.WriteLine($"Found zeros! Total: {zeroDetectionResult.TotalZeros}, Columns: {zeroDetectionResult.ZeroCountByColumn.Count}");
            originalData = new List<GenericCsvRow>(data);
            showZeroValueDialog = true;

            // Force UI update on UI thread
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Console.WriteLine("No zero values detected");
            // Show unit dialog since no zero dialog will appear
            await ShowUnitDialogAsync();
        }
    }

    private async Task ShowUnitDialogAsync()
    {
        Console.WriteLine($"ShowUnitDialogAsync called. Detected units count: {detectedColumnUnits.Count}");

        if(detectedColumnUnits.Count > 0)
        {
            Console.WriteLine($"Showing unit dialog with {detectedColumnUnits.Count} units");
            showUnitDialog = true;

            await InvokeAsync(StateHasChanged);
        }
        else
        {
            Console.WriteLine("No units detected, skipping dialog");
        }
    }
    private void OnZeroValueDecision(bool excludeZeros)
    {
        excludeZeroValues = excludeZeros;
        showZeroValueDialog = false;

        if (excludeZeros && zeroDetectionResult != null)
        {
            var columnsWithZeros = zeroDetectionResult.ZeroCountByColumn.Keys.ToList();
            data = CsvService.FilterZeroValues(originalData, columnsWithZeros);
            statusMessage = $"Excluded {zeroDetectionResult.TotalZeros} zero values from {columnsWithZeros.Count} columns";
        }
        else
        {
            data = new List<GenericCsvRow>(originalData);
            statusMessage = "Including all zero values in the data";
        }

        UpdateChart();

        // Show unit dialog after zero value dialog is handled
        _ = ShowUnitDialogAsync();
    }

