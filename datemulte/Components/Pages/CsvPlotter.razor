    private void RedistributeColumns()
    {
        var allColumns = selectedColumnsY1.Concat(selectedColumnsY2).Distinct().ToList();
        var chartCount = GetChartCount();

        if (allColumns.Count == 0) return;

        // Distribute columns evenly across all charts
        for (int i = 0; i < allColumns.Count; i++)
        {
            chartAssignments[allColumns[i]] = (i % chartCount) + 1;
        }
    }

