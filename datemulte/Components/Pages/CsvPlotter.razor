            data = state.Data;
            availableColumns = state.AvailableColumns;
            numericColumns = state.NumericColumns;
            timeColumn = state.TimeColumn;
            selectedColumnsY1 = state.SelectedColumnsY1;
            selectedColumnsY2 = state.SelectedColumnsY2;
            samplingLevel = state.SamplingLevel;
            enableY2Axis = state.EnableY2Axis;
            chartLayout = state.ChartLayout;
            splitLevel = state.SplitLevel;
            chartAssignments = state.ChartAssignments;
            rangeStartPoint = state.RangeStartPoint;
            rangeEndPoint = state.RangeEndPoint;
            calculatedColumns = state.CalculatedColumns;
            calculationFormulas = state.CalculationFormulas;
            calculationCache = state.CalculationCache;
            columnUnits = state.ColumnUnits;
            colorPalette = state.ColorScheme;
            defaultLineWidth = state.LineWidth;
            showDataPointMarkers = state.ShowDataPointMarkers;
            lineStyle = state.LineStyle;
            lineOpacity = (int)state.LineOpacity;
            enableChartZoom = state.EnableChartZoom;
            chartTheme = state.ChartTheme;
            yAxisAutoScale = state.YAxisAutoScale;
            yAxisMin = (int)state.YAxisMin;
            yAxisMax = (int)state.YAxisMax;
            y2AxisAutoScale = state.Y2AxisAutoScale;
            y2AxisMin = (int)state.Y2AxisMin;
            y2AxisMax = (int)state.Y2AxisMax;
            areaOpacity = state.AreaOpacity;
            chartBackgroundColor = state.ChartBackgroundColor;
            gridLineColor = state.GridLineColor;
            gridLineWidth = state.GridLineWidth;
            gridLineStyle = state.GridLineStyle;
            showXAxisLine = state.ShowXAxisLine;
            showYAxisLine = state.ShowYAxisLine;
            axisLineColor = state.AxisLineColor;
            axisLineWidth = state.AxisLineWidth;
            legendPosition = state.LegendPosition;
            tooltipTrigger = state.TooltipTrigger;
            enableSmoothLines = state.EnableSmoothLines;
            animationDuration = state.AnimationDuration;
            animationEasing = state.AnimationEasing;
            symbolSize = state.SymbolSize;
            symbolType = state.SymbolType;
            useLogScale = state.UseLogScale;
            detectedColumnUnits = new Dictionary<string, string>(state.ColumnUnits);
            lastLoadedFileName = state.FileName;
            lastLoadedFileTimestamp = state.LastFileLoadTimestamp;
            lastLoadedFileSize = state.LastFileSize;
            
            // Set the file name in state service so future saves go to the correct file-specific key
            if (!string.IsNullOrEmpty(lastLoadedFileName))
            {
                StateService.SetCurrentFile(lastLoadedFileName);
            }
            
            StateHasChanged();
            UpdateChart();
        }
        else if (rememberLastFile && !string.IsNullOrEmpty(state.FileName))
        {
            lastLoadedFileName = state.FileName;
            lastLoadedFileTimestamp = state.LastFileLoadTimestamp;
            lastLoadedFileSize = state.LastFileSize;
            
            // Set the file name in state service for future saves
            StateService.SetCurrentFile(lastLoadedFileName);
            
            statusMessage = $"Last file: {state.FileName}";
            if (state.LastFileLoadTimestamp.HasValue)
            {
                statusMessage += $" (loaded {FormatTimeSince(state.LastFileLoadTimestamp.Value)})";
            }
        }
    }
