@* Zero Value Detection Dialog *@
<MudDialog @bind-Visible="showZeroValueDialog"
           Options="new DialogOptions {
               CloseButton = false,
               BackdropClick = false,
               FullWidth = true,
               MaxWidth = MaxWidth.Small
           }"
           Style="background-color: #1e293b;">
    <TitleContent>
        <div style="background-color: #1e293b; color: #e2e8f0; padding: 20px 24px;">
            <MudText Typo="Typo.h6" Style="color: #e2e8f0;">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" Color="Color.Warning" />
                Zero Values Detected
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div style="background-color: #1e293b; color: #e2e8f0; padding: 24px;">
            @if (zeroDetectionResult != null)
            {
                <MudText Typo="Typo.body1" Class="mb-4" Style="color: #e2e8f0;">
                    The uploaded file contains <strong>@zeroDetectionResult.TotalZeros</strong> zero values across <strong>@zeroDetectionResult.ZeroCountByColumn.Count</strong> numeric columns.
                </MudText>

                <MudText Typo="Typo.body2" Class="mb-2" Style="color: #cbd5e1;">
                    Zero values found in the following columns:
                </MudText>

                <div style="border: 1px solid #334155; border-radius: 4px; padding: 12px; margin-bottom: 16px; background-color: #0f172a; max-height: 300px; overflow-y: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem; color: #e2e8f0;">
                        <thead style="background-color: #1e293b;">
                            <tr>
                                <th style="color: #cbd5e1; font-weight: 600; padding: 8px; text-align: left; border-bottom: 1px solid #334155;">Column Name</th>
                                <th style="color: #cbd5e1; font-weight: 600; padding: 8px; text-align: right; border-bottom: 1px solid #334155;">Zero Count</th>
                                <th style="color: #cbd5e1; font-weight: 600; padding: 8px; text-align: right; border-bottom: 1px solid #334155;">Percentage</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kvp in zeroDetectionResult.ZeroCountByColumn.OrderByDescending(x => x.Value))
                            {
                                var percentage = (kvp.Value * 100.0 / zeroDetectionResult.TotalRows).ToString("F1");
                                <tr style="color: #e2e8f0; background-color: #0f172a;">
                                    <td style="color: #e2e8f0; padding: 8px; border-bottom: 1px solid #334155;">@kvp.Key</td>
                                    <td style="color: #e2e8f0; padding: 8px; text-align: right; border-bottom: 1px solid #334155;">@kvp.Value</td>
                                    <td style="color: #e2e8f0; padding: 8px; text-align: right; border-bottom: 1px solid #334155;">@percentage%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <MudText Typo="Typo.body2" Style="color: #cbd5e1;">
                    Would you like to exclude rows containing zero values from the chart data?
                </MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <div style="background-color: #1e293b; padding: 16px 24px; width: 100%;">
            <MudButton OnClick="CancelZeroValueDialog" Color="Color.Default" Variant="Variant.Text" Style="color: #94a3b8;">
                Include Zeros
            </MudButton>
            <MudButton OnClick="@(() => OnZeroValueDecision(true))" Color="Color.Primary" Variant="Variant.Filled">
                Exclude Zeros
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>
