    private class DataFilter
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Column { get ; set; } = "";
        public string Operator { get; set; } = ">";
        public string Value { get; set; } = "";
        public bool IsEnabled { get; set; } = true;
    }
    private bool RequiresValue(string op)
    {
        return op != "even" && op != "odd" && op != "increasing" && op != "decreasing";
    }

    private void AddFilter()
    {
        if (string.IsNullOrWhiteSpace(newFilterColumn))
            return;

        if (RequiresValue(newFilterOperator) && string.IsNullOrWhiteSpace(newFilterValue))
            return;

        activeFilters.Add(new DataFilter
        {
            Column = newFilterColumn,
            Operator = newFilterOperator,
            Value = newFilterValue ?? ""
        });
        newFilterColumn = null;
        newFilterValue = "";
        UpdateChart();
    }
    private void RemoveFilter(string filterId)
    {
        activeFilters.RemoveAll(f => f.Id == filterId);
        UpdateChart();
    }
    private void ClearAllFilters()
    {
        activeFilters.Clear();
        UpdateChart();
    }
    private int GetFilteredRowCount()
    {
        return ApplyFilters(data).Count;
    }

