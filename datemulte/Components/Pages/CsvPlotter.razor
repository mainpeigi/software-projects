    private async void ToggleCustomizationPanel()
    {
        if (!showCustomizationPanel)
        {
            // Position at top-right when opening via button
            panelX = 400;
            panelY = 80;
        }

        showCustomizationPanel = !showCustomizationPanel;
        StateHasChanged();

        // Wait for the DOM to update, then resize charts
        await Task.Delay(100);
        await ResizeAllCharts();
    }

    private async void HandleChartRightClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Don't open customization panel in performance mode
        if (performanceMode) return;

        // Get viewport dimensions
        var viewportWidth = await JS.InvokeAsync<int>("eval", "window.innerWidth");
        var viewportHeight = await JS.InvokeAsync<int>("eval", "window.innerHeight");

        var panelWidth = 400;
        var panelHeight = 550;
        var margin = 20;

        // Calculate X position
        panelX = e.ClientX;
        if (panelX + panelWidth > viewportWidth - margin)
        {
            panelX = viewportWidth - panelWidth - margin;
        }
        if (panelX < margin)
        {
            panelX = margin;
        }

        // Calculate Y position
        // If clicking in bottom 40% of screen, position panel above cursor
        if (e.ClientY > viewportHeight * 0.6)
        {
            // Open upward - position panel so its bottom is near the cursor
            panelY = (int)e.ClientY - panelHeight + 40;
            if (panelY < margin)
            {
                panelY = margin;
            }
        }
        else
        {
            // Open downward
            panelY = (int)e.ClientY;
        }

        showCustomizationPanel = true;
        StateHasChanged();

        await Task.Delay(100);
        await ResizeAllCharts();
    }

    private void CloseCustomizationPanel()
    {
        if (showCustomizationPanel)
        {
            showCustomizationPanel = false;
            StateHasChanged();
        }
    }

    private void HandleAxisNameChanged(string axisType, string value)
    {
        // Store the axis name for the currently selected chart
        if (axisType == "X")
        {
            perChartXAxisNames[selectedChartForAxisEdit] = value;
        }
        else if (axisType == "Y")
        {
            perChartYAxisNames[selectedChartForAxisEdit] = value;
        }
        else if (axisType == "Y2")
        {
            perChartY2AxisNames[selectedChartForAxisEdit] = value;
        }

        // Also update global values - but DON'T trigger the two-way binding
        // by updating these during the change event (causes issues)
        // Only update for display purposes in the UI
        if (chartLayout == "horizontal" || chartLayout == "vertical")
        {
            // In split mode, global values are only for UI display
            if (axisType == "X")
            {
                xAxisName = value;
            }
            else if (axisType == "Y")
            {
                yAxisName = value;
            }
            else if (axisType == "Y2")
            {
                y2AxisName = value;
            }
        }
        else
        {
            // In single mode, update global values normally
            if (axisType == "X")
            {
                xAxisName = value;
            }
            else if (axisType == "Y")
            {
                yAxisName = value;
            }
            else if (axisType == "Y2")
            {
                y2AxisName = value;
            }
        }

        UpdateChart();
    }

    private void OnSelectedChartChanged()
    {
        // Load the axis names for the newly selected chart
        if (perChartXAxisNames.ContainsKey(selectedChartForAxisEdit))
        {
            xAxisName = perChartXAxisNames[selectedChartForAxisEdit];
        }
        else
        {
            xAxisName = ""; // Default to empty if not set
        }

        if (perChartYAxisNames.ContainsKey(selectedChartForAxisEdit))
        {
            yAxisName = perChartYAxisNames[selectedChartForAxisEdit];
        }
        else
        {
            yAxisName = ""; // Default to empty if not set
        }

        if (perChartY2AxisNames.ContainsKey(selectedChartForAxisEdit))
        {
            y2AxisName = perChartY2AxisNames[selectedChartForAxisEdit];
        }
        else
        {
            y2AxisName = ""; // Default to empty if not set
        }

        StateHasChanged();
    }

