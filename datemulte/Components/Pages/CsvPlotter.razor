            enableLazyLoading = prefs.EnableLazyLoading;
            useScientificNotation = prefs.UseScientificNotation;
        }
        else
        {
            await LoadPreferences();
        }
        
        if (data.Count > 0)
        {
            UpdateChart();
        }
        
        await InvokeAsync(StateHasChanged);
