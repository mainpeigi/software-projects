    private object BuildWaterfallChartOption(List<string> columns, List<string> colors)
    {
        var sampledData = GetSampledData();

        // Generate xAxis labels
        List<string> xAxisData;
        if (!string.IsNullOrEmpty(timeColumn))
        {
            xAxisData = sampledData.Select(d => {
                var timeValue = d.GetValue(timeColumn) ?? "";
                return CsvService.FormatTimeToMinutesSeconds(timeValue);
            }).ToList();
        }
        else
        {
            xAxisData = Enumerable.Range(1, sampledData.Count).Select(i => i.ToString()).ToList();
        }

        var series = new List<object>();

        foreach (var (col, index) in columns.Select((c, i) => (c, i)))
        {
            var values = new List<double>();
            double cumulative = 0;

            foreach (var row in sampledData)
            {
                var val = row.GetNumericValueOrNull(col);
                if (val != null && val is double d)
                {
                    cumulative += d;
                    values.Add(Math.Round(cumulative, decimalPlaces));
                }
                else
                {
                    values.Add(cumulative);
                }
            }

            series.Add(new
            {
                name = col,
                type = "bar",
                stack = "total",
                itemStyle = new { color = colors[index % colors.Count] },
                data = values
            });
        }

        return new
        {
            title = showTitle ? new { text = titleText, left = titleAlignment, top = titleTop, textStyle = new { color = titleColor, fontSize = titleFontSize, fontWeight = titleFontWeight } } : null,
            tooltip = new { trigger = "axis", axisPointer = new { type = "shadow" } },
            legend = showLegend ? new { data = columns.ToArray(), top = legendPosition == "bottom" ? "bottom" : "top", textStyle = new { color = legendTextColor } } : null,
            grid = new { left = gridLeft, right = gridRight, bottom = gridBottom, top = gridTop, containLabel = true },
            xAxis = new { type = "category", data = xAxisData, axisLabel = new { color = xAxisLabelColor, rotate = xAxisLabelRotate }, axisLine = new { show = showXAxisLine, lineStyle = new { color = axisLineColor, width = axisLineWidth } } },
            yAxis = new { type = "value", axisLabel = new { color = yAxisLabelColor }, axisLine = new { show = showYAxisLine, lineStyle = new { color = axisLineColor, width = axisLineWidth } }, splitLine = new { show = showHorizontalGrid, lineStyle = new { color = gridLineColor, width = gridLineWidth, type = gridLineStyle } } },
            series = series.ToArray()
        };
    }

