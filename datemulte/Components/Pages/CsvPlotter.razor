    private int GetChartCount()
    {
        return (int)Math.Pow(2, splitLevel);
    }

    private object[]? GetDataZoomConfig(string chartIdOrNumber)
    {
        if (!enableChartZoom) return null;

        // ALWAYS enable zoom controls on all charts
        // The JavaScript synchronization will handle which charts sync together
        var zoomList = new List<object>();
        if (showDataZoomInside)
        {
            zoomList.Add(new
            {
                type = "inside",
                xAxisIndex = 0,
                yAxisIndex = new int[] {}, // Y-axis is always locked - only X-axis zooms
                zoomOnMouseWheel = true,
                moveOnMouseMove = true,
                start = hasActiveZoom ? savedZoomStart : 0,
                end = hasActiveZoom ? savedZoomEnd : 100
            });
        }
        if (showDataZoomSlider)
        {
            zoomList.Add(new
            {
                type = "slider",
                xAxisIndex = 0,
                yAxisIndex = new int[] {}, // Y-axis is always locked - only X-axis zooms
                height = dataZoomHeight,
                bottom = 10,
                backgroundColor = dataZoomBackgroundColor,
                fillerColor = dataZoomFillerColor,
                borderColor = dataZoomBorderColor,
                start = hasActiveZoom ? savedZoomStart : 0,
                end = hasActiveZoom ? savedZoomEnd : 100
            });
        }
        return zoomList.Count > 0 ? zoomList.ToArray() : null;
    }

    private RenderFragment RenderSplitCharts() => builder =>
    {
        var chartCount = GetChartCount();
        var isHorizontal = chartLayout == "horizontal";

        // For multiple split levels, we need nested containers
        RenderChartGrid(builder, chartCount, isHorizontal, 0);
    };

    private void RenderChartGrid(Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder, int chartCount, bool isHorizontal, int sequence)
    {
        if (chartCount == 2)
        {
            // Base case: render 2 charts
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "style", isHorizontal
                ? "display: flex; flex-direction: column; height: 100%; gap: 16px;"
                : "display: flex; flex-direction: row; height: 100%; gap: 16px;");

            for (int i = 1; i <= 2; i++)
            {
                var chartId = i;
                builder.OpenComponent<MudBlazor.MudPaper>(sequence++);
                builder.AddAttribute(sequence++, "Elevation", 3);
                builder.AddAttribute(sequence++, "Class", "pa-4");
                builder.AddAttribute(sequence++, "Style", "flex: 1; border-radius: 12px; background-color: #1e293b;");
                builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b =>
                {
                    b.OpenElement(0, "div");
                    b.AddAttribute(1, "id", $"chart{chartId}");
                    b.AddAttribute(2, "style", "width: 100%; height: 100%;");
                    b.AddAttribute(3, "oncontextmenu", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HandleChartRightClick));
                    b.AddEventPreventDefaultAttribute(4, "oncontextmenu", true);
                    b.CloseElement();
                }));
                builder.CloseComponent();
            }

            builder.CloseElement();
        }
        else if (chartCount == 4)
        {
            // 2 splits: 2x2 or 4 in a row/column
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "style", isHorizontal
                ? "display: flex; flex-direction: column; height: 100%; gap: 16px;"
                : "display: flex; flex-direction: row; height: 100%; gap: 16px;");

            // Render 2 groups of 2 charts
            for (int group = 0; group < 2; group++)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "style", isHorizontal
                    ? "display: flex; flex-direction: row; flex: 1; gap: 16px;"
                    : "display: flex; flex-direction: column; flex: 1; gap: 16px;");

                for (int i = 0; i < 2; i++)
                {
                    var chartId = group * 2 + i + 1;
                    builder.OpenComponent<MudBlazor.MudPaper>(sequence++);
                    builder.AddAttribute(sequence++, "Elevation", 3);
                    builder.AddAttribute(sequence++, "Class", "pa-4");
                    builder.AddAttribute(sequence++, "Style", "flex: 1; border-radius: 12px; background-color: #1e293b;");
                    builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b =>
                    {
                        b.OpenElement(0, "div");
                        b.AddAttribute(1, "id", $"chart{chartId}");
                        b.AddAttribute(2, "style", "width: 100%; height: 100%;");
                        b.AddAttribute(3, "oncontextmenu", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HandleChartRightClick));
                        b.AddEventPreventDefaultAttribute(4, "oncontextmenu", true);
                        b.CloseElement();
                    }));
                    builder.CloseComponent();
                }

                builder.CloseElement();
            }

            builder.CloseElement();
        }
        else if (chartCount == 8)
        {
            // 3 splits: 2x2x2 grid
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "style", isHorizontal
                ? "display: flex; flex-direction: column; height: 100%; gap: 16px;"
                : "display: flex; flex-direction: row; height: 100%; gap: 16px;");

            // Render 2 groups of 4 charts (each group is 2x2)
            for (int mainGroup = 0; mainGroup < 2; mainGroup++)
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "style", isHorizontal
                    ? "display: flex; flex-direction: row; flex: 1; gap: 16px;"
                    : "display: flex; flex-direction: column; flex: 1; gap: 16px;");

                // Each main group contains 2 subgroups
                for (int subGroup = 0; subGroup < 2; subGroup++)
                {
                    builder.OpenElement(sequence++, "div");
                    builder.AddAttribute(sequence++, "style", isHorizontal
                        ? "display: flex; flex-direction: column; flex: 1; gap: 16px;"
                        : "display: flex; flex-direction: row; flex: 1; gap: 16px;");

                    for (int i = 0; i < 2; i++)
                    {
                        var chartId = mainGroup * 4 + subGroup * 2 + i + 1;
                        builder.OpenComponent<MudBlazor.MudPaper>(sequence++);
                        builder.AddAttribute(sequence++, "Elevation", 3);
                        builder.AddAttribute(sequence++, "Class", "pa-2");
                        builder.AddAttribute(sequence++, "Style", "flex: 1; border-radius: 8px; background-color: #1e293b;");
                        builder.AddAttribute(sequence++, "ChildContent", (RenderFragment)(b =>
                        {
                            b.OpenElement(0, "div");
                            b.AddAttribute(1, "id", $"chart{chartId}");
                            b.AddAttribute(2, "style", "width: 100%; height: 100%;");
                            b.AddAttribute(3, "oncontextmenu", Microsoft.AspNetCore.Components.EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, HandleChartRightClick));
                            b.AddEventPreventDefaultAttribute(4, "oncontextmenu", true);
                            b.CloseElement();
                        }));
                        builder.CloseComponent();
                    }

                    builder.CloseElement();
                }

                builder.CloseElement();
            }

            builder.CloseElement();
        }
    }

    private string FormatTimeSince(DateTime timestamp)
    {
        var elapsed = DateTime.Now - timestamp;
        if (elapsed.TotalMinutes < 1)
            return "just now";
        if (elapsed.TotalHours < 1)
            return $"{(int)elapsed.TotalMinutes} min ago";
        if (elapsed.TotalDays < 1)
            return $"{(int)elapsed.TotalHours} hr ago";
        return $"{(int)elapsed.TotalDays} days ago";
    }

    private async Task RefreshData()
    {
        if (selectedFile != null)
        {
            await LoadCsvData();
        }
    }

    private void RecalculateStatistics()
    {
        if (data.Count == 0)
        {
            columnStatistics.Clear();
            correlationMatrix = null;
            return;
        }

        var selectedColumns = selectedColumnsY1.Concat(selectedColumnsY2).Distinct().ToList();
        if (!selectedColumns.Any())
        {
            columnStatistics.Clear();
            correlationMatrix = null;
            return;
        }

        var dataToAnalyze = analyzeFullDataset ? data : GetSampledData();

        columnStatistics = StatisticsService.CalculateMultipleStatistics(dataToAnalyze, selectedColumns);

        if (selectedColumns.Count >= 2)
        {
            correlationMatrix = StatisticsService.CalculateCorrelationMatrix(dataToAnalyze, selectedColumns);
        }
        else
        {
            correlationMatrix = null;
        }

        StateHasChanged();
    }

    private string GetShortColumnName(string columnName)
    {
        if (columnName.Length <= 15)
            return columnName;

        return columnName.Substring(0, 12) + "...";
    }

    private string GetCorrelationColor(double correlation)
    {
        var absCorr = Math.Abs(correlation);

        if (absCorr >= 0.9)
            return correlation > 0 ? "rgba(46, 125, 50, 0.3)" : "rgba(198, 40, 40, 0.3)";
        else if (absCorr >= 0.7)
            return correlation > 0 ? "rgba(102, 187, 106, 0.3)" : "rgba(239, 83, 80, 0.3)";
        else if (absCorr >= 0.5)
            return correlation > 0 ? "rgba(165, 214, 167, 0.3)" : "rgba(255, 138, 128, 0.3)";
        else if (absCorr >= 0.3)
            return "rgba(255, 245, 157, 0.3)";
        else
            return "rgba(245, 245, 245, 0.3)";
    }

    private List<string> GetFilteredColumns()
    {
        // If no sensor groups detected, return all numeric columns
        if (sensorGroups.Count == 0)
            return numericColumns;

        // If "All" is selected, return all numeric columns
        if (selectedSensorGroup == "All")
            return numericColumns;

        // Filter columns by selected sensor group
        return numericColumns.Where(col =>
            columnToGroupMapping.ContainsKey(col) &&
            columnToGroupMapping[col] == selectedSensorGroup
        ).ToList();
    }

    private string GetColumnDisplayName(string columnName)
    {
        // If grouped format, optionally show group prefix
        if (sensorGroups.Count > 0 && columnToGroupMapping.ContainsKey(columnName))
        {
            var group = columnToGroupMapping[columnName];
            if (!string.IsNullOrEmpty(group) && selectedSensorGroup == "All")
            {
                return $"[{group}] {columnName}";
            }
        }
        return columnName;
    }
