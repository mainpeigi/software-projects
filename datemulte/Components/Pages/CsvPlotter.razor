    private async void HandleFileSelected(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 0)
        {
            selectedFile = e.File;
            fileLoaded = false;
            Console.WriteLine($"File selected: {selectedFile?.Name}");

            // Check if it's an Excel file
            var extension = Path.GetExtension(selectedFile?.Name ?? "").ToLower();
            if (extension == ".xlsx" || extension == ".xls")
            {
                try
                {
                    isLoading = true;
                    statusMessage = "Detecting Excel sheets...";
                    StateHasChanged();


                    using var stream = selectedFile!.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
                    var (isExcel, sheets) = await CsvService.DetectExcelSheetsAsync(stream, selectedFile.Name);

                    if (isExcel && sheets.Count > 0)
                    {
                        excelSheets = sheets;
                        pendingExcelFile = selectedFile;
                        showSheetSelector = true;
                        selectedSheet = sheets.Count == 1 ? sheets[0] : null;
                        // If only one sheet, auto-load it
                        if (sheets.Count == 1)
                        {
                            await LoadSelectedSheet();
                        }
                        else
                        {
                            statusMessage = $"Please select a sheet from {sheets.Count} available sheets";
                            isLoading = false;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error detecting Excel sheets: {ex.Message}");
                    statusMessage = $"Error: {ex.Message}";
                    isLoading = false;
                }
            }
            else
            {
                showSheetSelector = false;
            }

            StateHasChanged();
        }
    }

