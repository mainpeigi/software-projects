@page "/csv-plotter"
@page "/csv-plotter/{SessionId:guid}"
@using Datemulte_2.Models
@using Datemulte_2.Services
@using MudBlazor;
@using MudBlazor.Charts
@using MudBlazor.Services;
@using Datemulte_2.Services.DataManagement
@using Datemulte_2.Models.DataManagement
@using Datemulte_2.Components.Collaboration
@using Datemulte_2.Components.Dialogs
@using Datemulte_2.Components.Notifications
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject PreferencesService PreferencesService
@inject CsvPlotterStateService StateService
@inject CsvExportService ExportService
@inject SessionStorageService SessionStorage
@inject DataSessionService DataSessionService
@inject LocalProfileService AuthService
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>CSV Data Plotter</PageTitle>

@if (currentSessionId.HasValue && AuthService.IsAuthenticated)
{
    <CollaborationToolbar SessionId="@currentSessionId.Value"
                          OwnerId="@(AuthService.CurrentUserId ?? Guid.Empty)"
                          OnToggleComments="ToggleCommentsPanel" />
}

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0" Style="height: calc(100vh - 120px);" @onclick="CloseCustomizationPanel">
    <MudPaper Elevation="0" Class="d-flex" Style="height: 100%; position: relative; background-color: #0f172a;">

        <!-- Left Sidebar Controls -->
        @if (showSidebar)
        {
            <MudPaper Elevation="4" Class="pa-4" Style="width: 380px; overflow-y: auto; border-radius: 0; background-color: #1e293b;">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h6" Color="Color.Primary">
                        <MudIcon Icon="@Icons.Material.Filled.ShowChart" Class="mr-2" /> Data Plotter
                    </MudText>
                    <div class="d-flex gap-2">
                        <MudIconButton Icon="@(isChartFullscreen ? Icons.Material.Filled.FullscreenExit : Icons.Material.Filled.Fullscreen)" Color="Color.Default" Size="Size.Small" OnClick="ToggleChartFullscreen"/>
                        <MudTooltip Text="@(performanceMode ? "Performance Mode: ON" : "Performance Mode: OFF")">
                            <MudIconButton Icon="@Icons.Material.Filled.Speed"
                                           Color="@(performanceMode ? Color.Success : Color.Default)"
                                           OnClick="@(async () => await TogglePerformanceMode())"/>
                        </MudTooltip>
                        <MudTooltip Text="Hide sidebar">
                            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                           Color="Color.Default"
                                           OnClick="@(() => showSidebar = !showSidebar)" />
                        </MudTooltip>
                    </div>
                </div>

                <MudDivider Class="mb-4" />

            <!-- File Upload Section -->
            <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background: linear-gradient(135deg, #20818e15 0%, #06b6d415 100%); background-color: #1e293b;">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                    <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Small" /> Upload File
                </MudText>
                <div id="fileDropZone"
                    style="@($"border: 2px dashed {(isDragging ? "#06b6d4" : "#20818e")}; text-align: center; cursor: pointer; background-color: {(isDragging ? "#06b6d420" : "#1e293b")}; transition: all 0.2s ease; padding: 16px; border-radius: 4px;")"
                    @ondragenter="HandleDragEnter"
                    @ondragenter:preventDefault="true"
                    @ondragleave="HandleDragLeave"
                    @ondragleave:preventDefault="true"
                    @ondragover="HandleDragOver"
                    @ondragover:preventDefault="true"
                    @ondrop="HandleDrop"
                    @ondrop:preventDefault="true">
                    <InputFile OnChange="HandleFileSelected" id="csvFileInput" style="display: none;" />
                    <label for="csvFileInput" style="cursor: pointer; display: block; margin: 0;">
                        <MudIcon Icon="@(isDragging ? Icons.Material.Filled.FileDownload : Icons.Material.Filled.CloudUpload)" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.body2" Color="Color.Primary" Class="mt-2">
                            @(isDragging ? "Drop file here" : "Click or drag file here")
                        </MudText>
                    </label>
                </div>
                @if (selectedFile != null)
                {
                    <div class="file-chip-container mt-2" @onmouseenter="() => isHoveringFile = true" @onmouseleave="() => isHoveringFile = false">
                        <MudChip T="string" Icon="@Icons.Material.Filled.InsertDriveFile" Color="Color.Info" Size="Size.Small">
                            @selectedFile.Name
                        </MudChip>
                        @if (isHoveringFile)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                          Size="Size.Small"
                                          Color="Color.Error"
                                          Class="remove-file-btn"
                                          OnClick="RemoveSelectedFile"
                                          title="Remove file" />
                        }
                    </div>
                }

                @if (showSheetSelector && excelSheets.Count > 0)
                {
                    <MudPaper Elevation="1" Class="pa-3 mt-3" Style="background-color: #1e293b; border: 1px solid #20818e;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Small" /> Select Excel Sheet
                        </MudText>
                        <MudSelect @bind-Value="selectedSheet"
                                   Label="Sheet"
                                   Variant="Variant.Outlined"
                                   Dense="true"
                                   AnchorOrigin="Origin.BottomCenter"
                                   Class="mb-2">
                            @foreach (var sheet in excelSheets)
                            {
                                <MudSelectItem Value="@sheet">@sheet</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButton Variant="Variant.Filled"
                                   FullWidth="true"
                                   Disabled="@(selectedSheet == null || isLoading)"
                                   OnClick="LoadSelectedSheet"
                                   StartIcon="@Icons.Material.Filled.Check"
                                   Color="Color.Primary">
                            @if (isLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Loading...</span>
                            }
                            else
                            {
                                <span>Load Sheet</span>
                            }
                        </MudButton>
                    </MudPaper>
                }

                @if (rememberLastFile && !string.IsNullOrEmpty(lastLoadedFileName) && data.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="mt-2" Style="color: #94a3b8;">
                        <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" Style="vertical-align: middle;" />
                        @lastLoadedFileName
                        @if (lastLoadedFileTimestamp.HasValue)
                        {
                            <span> (@FormatTimeSince(lastLoadedFileTimestamp.Value))</span>
                        }
                    </MudText>
                }

                <div class="tooltip-wrapper" data-tooltip="Click to load and analyze your CSV file">
                    <MudButton Variant="Variant.Filled"
                               FullWidth="true"
                               Class="mt-3"
                               Disabled="@(selectedFile == null || isLoading)"
                               OnClick="LoadCsvData"
                               StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Default">
                        @if (isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" Style="color: #cbd5e1;"/>
                            <span Style="color: #cbd5e1;">Loading...</span>
                        }
                        else if(fileLoaded)
                        {
                            <span Style="color: #cbd5e1">File Loaded</span>
                        }
                        else
                        {
                            <span Style="color: #cbd5e1;">Load File</span>
                        }
                    </MudButton>
                </div>

                @if (enableAutoRefresh && data.Count > 0)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               FullWidth="true"
                               Class="mt-2"
                               Disabled="isLoading"
                               OnClick="RefreshData"
                               StartIcon="@Icons.Material.Filled.Refresh">
                        Refresh Data
                    </MudButton>
                }
                <MudDivider Class="my-3" />

                <!-- Paste Data Section -->
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                    <MudIcon Icon="@Icons.Material.Filled.ContentPaste" Size="Size.Small" /> Paste Data
                </MudText>

                <textarea @ref="pasteTextArea"
                          rows="4"
                          placeholder="Paste your CSV/TSV data here, then click Load"
                          style="width: 100%; background-color: #0f172a; color: #f1f5f9; border: 1px solid #334155; border-radius: 4px; padding: 10px; font-family: monospace; font-size: 12px; resize: vertical;"></textarea>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Info"
                           FullWidth="true"
                           Disabled="@(isLoading || isPasting)"
                           OnClick="ProcessPastedText"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Class="mt-2">
                    @if (isPasting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2"/>
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Load Pasted Data</span>
                    }
                </MudButton>

                @if (!string.IsNullOrEmpty(pasteErrorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2" Style="font-size: 0.8rem;">@pasteErrorMessage</MudAlert>
                }

                @if (pastedDataInfo != null)
                {
                    <MudChip T="string" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mt-2">@pastedDataInfo</MudChip>
                }
            </MudPaper>

            <!-- Session Manager -->
            <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                    <MudIcon Icon="@Icons.Material.Filled.Save" Size="Size.Small" /> Sessions
                </MudText>

                <MudTextField @bind-value="newSessionName" Label="Session Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" Disabled="@(string.IsNullOrEmpty(newSessionName) || data.Count == 0)" OnClick="SaveSessionAs" StartIcon="@Icons.Material.Filled.SaveAs" Class="mb-2">
                    Save Session
                </MudButton> 

                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" FullWidth="true" OnClick="@(async () => {await LoadSessionList(); showSessionManager = true; StateHasChanged();})" StartIcon="@Icons.Material.Filled.FolderOpen">
                    Load Session
                </MudButton>
            </MudPaper>

            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                Sessions are saved on this laptop. Copy the complete application folder to transfer them.
            </MudAlert>
            <MudDialog @bind-Visible="showSessionManager">
                <TitleContent>
                    <MudText Typo="Typo.h6">Saved Sessions</MudText>
                </TitleContent>
                <DialogContent>
                    @if (savedSessions.Count == 0)
                    {
                        <MudText>No saved sessions found.</MudText>
                    }
                    else
                    {
                        <MudList T="string">
                            @foreach (var session in savedSessions.OrderByDescending(s => s.LastModified))
                            {
                                <MudListItem>
                                    <div class="d-flex justify-space-between align-center" style="width: 100%;">
                                        <div>
                                            <MudText Typo="Typo.body1"><strong>@session.Name</strong></MudText>
                                            <MudText Typo="Typo.caption">@session.FileName - @session.DataRowCount rows</MudText>
                                            <MudText Typo="Typo.caption">@session.LastModified.ToString("g")</MudText>
                                        </div>
                                        <div>
                                            <MudIconButton Icon="@Icons.Material.Filled.OpenInBrowser" Color="Color.Primary"
                                                           OnClick="@(async () => await LoadSessionAndClose(session.Id))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                           OnClick="@(async () => await DeleteSession(session.Id))" />
                                        </div>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </DialogContent>
                <DialogActions>
                    <MudButton OnClick="@(() => { showSessionManager = false; StateHasChanged(); })">CLOSE</MudButton>
                </DialogActions>
            </MudDialog>

            @if (data.Count > 0)
            {
                <!-- Data Control Mode Toggle -->
                <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background: linear-gradient(135deg, #20818e15 0%, #06b6d415 100%); background-color: #1e293b;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" /> Data Control Mode
                    </MudText>
                    <MudRadioGroup @bind-Value="dataControlMode" @bind-Value:after="OnDataControlModeChanged">
                        <MudRadio Value="@("range")" Color="Color.Primary" Dense="true">Data Range (Select specific ranges)</MudRadio>
                        <MudRadio Value="@("sampling")" Color="Color.Primary" Dense="true">Data Sampling (Sample all data)</MudRadio>
                    </MudRadioGroup>
                </MudPaper>

                @if (dataControlMode == "range")
                {
                    <!-- Data Range Picker -->
                    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.LineAxis" Size="Size.Small" /> Data Range
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mb-3" Style="color: #94a3b8;">
                            Total Records: @data.Count.ToString("N0")
                        </MudText>

                        <MudNumericField Value="rangeStartPoint"
                                         ValueChanged="@((int val) => OnRangeStartChanged(val))"
                                         Label="Start Point"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         Max="@(data.Count - 1)"
                                         Step="1000"
                                         Immediate="true"
                                         Class="mb-3" />
                        <MudNumericField Value="rangeEndPoint"
                                         ValueChanged="@((int val) => OnRangeEndChanged(val))"
                                         Label="End Point"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="@rangeStartPoint"
                                         Max="@GetMaxEndPoint()"
                                         Step="1000"
                                         Immediate="true"
                                         Class="mb-3" />

                        <MudText Typo="Typo.caption" Style="color: #94a3b8;">
                            Selected: @GetSelectedRangeCount().ToString("N0") points (Max: Start Point + 500,000)
                        </MudText>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   FullWidth="true"
                                   Class="mt-2"
                                   OnClick="ResetRange"
                                   StartIcon="@Icons.Material.Filled.Refresh">
                            Reset to Full Range
                        </MudButton>

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" /> Sampling
                        </MudText>
                        <MudRadioGroup T="int" @bind-Value="samplingLevel" @bind-Value:after="UpdateChart">
                            <MudRadio Value="1000" Color="Color.Primary" Dense="true">1,000 points (Fastest)</MudRadio>
                            <MudRadio Value="5000" Color="Color.Primary" Dense="true">5,000 points (Fast)</MudRadio>
                            <MudRadio Value="25000" Color="Color.Primary" Dense="true">25,000 points (Medium)</MudRadio>
                            <MudRadio Value="100000" Color="Color.Primary" Dense="true">100,000 points (Slow)</MudRadio>
                            <MudRadio Value="0" Color="Color.Primary" Dense="true">All Data (Slowest)</MudRadio>
                        </MudRadioGroup>
                    </MudPaper>
                }
                else
                {
                    <!-- Data Sampling -->
                    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.Tune" Size="Size.Small" /> Data Sampling
                        </MudText>
                        <MudRadioGroup T="int" @bind-Value="samplingLevel" @bind-Value:after="UpdateChart">
                            <MudRadio Value="1000" Color="Color.Primary" Dense="true">1,000 points (Fastest)</MudRadio>
                            <MudRadio Value="5000" Color="Color.Primary" Dense="true">5,000 points (Fast)</MudRadio>
                            <MudRadio Value="25000" Color="Color.Primary" Dense="true">25,000 points (Medium)</MudRadio>
                            <MudRadio Value="100000" Color="Color.Primary" Dense="true">100,000 points (Slow)</MudRadio>
                            <MudRadio Value="0" Color="Color.Primary" Dense="true">All Data (Slowest)</MudRadio>
                        </MudRadioGroup>
                    </MudPaper>
                }
                <!-- Chart Filtering Options -->
                <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                    <div Class="d-flex justifiy-space-between align-center mb-2">
                        <MudText Typo="Typo.subtitle2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Size="Size.Small"/> Data Filters
                        </MudText>
                        <MudIconButton Icon="@(showFilterPanel ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" OnClick="@(() => showFilterPanel = !showFilterPanel)" />
                    </div>

                    @if (activeFilters.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Style="color: #94a3b8;" Class="mb-2">
                            @GetFilteredRowCount().ToString("N0") of @data.Count.ToString("N0") rows match
                        </MudText>
                    }

                    @if(showFilterPanel)
                    {
                        @if(activeFilters.Count > 0)
                        {
                            <MudStack Spacing="2" Class="mb-3">
                                @foreach (var filter in activeFilters)
                                {
                                    <MudPaper Elevation="0" Class="pa-2" Style="background-color: #0f172a; border-radius: 4px;">
                                        <div class="d-flex align-center gap-2">
                                            <MudCheckBox T="bool" Value="filter.IsEnabled" ValueChanged="@((bool v) => { filter.IsEnabled = v; UpdateChart(); })"  Size="Size.Small" Color="Color.Primary" />
                                            <MudText Typo="Typo.body2" Style="color: #e2e8f0; flex:1">@filter.Column @filter.Operator @filter.Value</MudText>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveFilter(filter.Id))"/>
                                        </div>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                        <MudText Typo="Typo.caption" Class="mb-2" Style="color: #94a3b8;">Add New Filter</MudText>
                        <div style="display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: end;">
                            <MudSelect @bind-Value="newFilterColumn" Label="Column" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                @foreach (var col in numericColumns)
                                {
                                    <MudSelectItem Value="@col">@col</MudSelectItem>
                                }
                            </MudSelect>

                            <MudSelect @bind-Value="newFilterOperator" Label="Op" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="width: 100px;">
                                <MudSelectItem Value="@(">")">&gt;</MudSelectItem>
                                <MudSelectItem Value="@("<")">&lt;</MudSelectItem>
                                <MudSelectItem Value="@(">=")">&gt;=</MudSelectItem>
                                <MudSelectItem Value="@("<=")">&lt;=</MudSelectItem>
                                <MudSelectItem Value="@("==")">=</MudSelectItem>
                                <MudSelectItem Value="@("!=")">&ne;</MudSelectItem>
                                <MudSelectItem Value="@("even")">Even</MudSelectItem>
                                <MudSelectItem Value="@("odd")">Odd</MudSelectItem>
                                <MudSelectItem Value="@("increasing")">↑ Inc</MudSelectItem>
                                <MudSelectItem Value="@("decreasing")">↓ Dec</MudSelectItem>
                            </MudSelect>

                            <MudTextField @bind-Value="newFilterValue" Label="Value" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </div>

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" Class="mt-2" Disabled="@(string.IsNullOrEmpty(newFilterColumn) || (RequiresValue(newFilterOperator) && string.IsNullOrEmpty(newFilterValue)))" OnClick="AddFilter" StartIcon="@Icons.Material.Filled.Add">
                            Add Filter
                        </MudButton>

                        @if (activeFilters.Count > 0)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" FullWidth="true" Class="mt-2"
                                    OnClick="ClearAllFilters" StartIcon="@Icons.Material.Filled.ClearAll">
                                Clear All Filters
                            </MudButton>
                        }
                    }
                    else if(activeFilters.Count > 0)
                    {
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var filter in activeFilters.Where(f=>f.IsEnabled))
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => RemoveFilter(filter.Id))">
                                    @filter.Column @filter.Operator @filter.Value
                                </MudChip>
                            }
                        </div> 
                    }
                </MudPaper> 
                <!-- Chart Layout Options -->
                <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                        <MudIcon Icon="@Icons.Material.Filled.ViewQuilt" Size="Size.Small" /> Chart Layout
                    </MudText>
                    <MudRadioGroup @bind-Value="chartLayout" @bind-Value:after="OnChartLayoutChanged">
                        <MudRadio Value="@("single")" Color="Color.Primary" Dense="true">Single Chart</MudRadio>
                        <MudRadio Value="@("horizontal")" Color="Color.Primary" Dense="true">Split Horizontally</MudRadio>
                        <MudRadio Value="@("vertical")" Color="Color.Primary" Dense="true">Split Vertically</MudRadio>
                    </MudRadioGroup>

                    @if (chartLayout != "single")
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.body2" Class="mb-2"><strong>Split Level:</strong></MudText>
                        <MudSlider @bind-Value="splitLevel" @bind-Value:after="OnSplitLevelChanged" Min="1" Max="3" Step="1" Color="Color.Primary" ValueLabel="true" Class="mb-2">
                            @splitLevel @(splitLevel == 1 ? "split" : "splits") (@GetChartCount() charts)
                        </MudSlider>
                    }
                </MudPaper>

                @if (chartLayout != "single")
                {
                    <!-- Chart Assignment for Split View -->
                    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background: linear-gradient(135deg, #20818e15 0%, #06b6d415 100%); background-color: #1e293b;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Small" /> Chart Assignment
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mb-3" Style="color: #94a3b8;">
                            Assign columns to charts (1-@GetChartCount())
                        </MudText>

                        @foreach (var col in selectedColumnsY1.Concat(selectedColumnsY2).Distinct())
                        {
                            var isY1 = selectedColumnsY1.Contains(col);
                            var currentChart = chartAssignments.ContainsKey(col) ? chartAssignments[col] : 1;

                            <MudPaper Outlined="true" Class="pa-2 mb-2" Style="border-color: #e0e0e0;">
                                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                                    <div style="flex: 1; min-width: 120px;">
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@col</MudText>
                                        <MudText Typo="Typo.caption" Style="color: #999;">
                                            @(isY1 ? "Primary Y-Axis" : "Secondary Y-Axis")
                                        </MudText>
                                    </div>
                                    <MudRadioGroup T="int" Value="@currentChart" ValueChanged="@((int val) => AssignToChart(col, val))" Style="display: flex; flex-direction: row; flex-wrap: wrap; gap: 8px;">
                                        @for (int i = 1; i <= GetChartCount(); i++)
                                        {
                                            var chartNum = i;
                                            <MudRadio T="int" Value="@chartNum" Color="Color.Primary" Dense="true">@chartNum</MudRadio>
                                        }
                                    </MudRadioGroup>
                                </div>
                            </MudPaper>
                        }

                        @if (!selectedColumnsY1.Any() && !selectedColumnsY2.Any())
                        {
                            <MudText Typo="Typo.body2" Class="text-center pa-3" Style="color: #cbd5e1;">
                                No columns selected. Select columns to assign them to charts.
                            </MudText>
                        }
                    </MudPaper>
                }

                <!-- Second Y-Axis Toggle -->
                <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                    <MudSwitch @bind-Value="enableY2Axis" @bind-Value:after="OnY2AxisToggled" Color="Color.Secondary" Label="Enable Second Y-Axis" />
                </MudPaper>

                <!-- Y-Axis Range Control -->
                <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                        <MudIcon Icon="@Icons.Material.Filled.VerticalAlignCenter" Size="Size.Small" /> Primary Y-Axis Range
                    </MudText>
                    <MudDivider Class="mb-2" />
                    <MudSwitch @bind-Value="yAxisAutoScale" @bind-Value:after="OnYAxisAutoScaleChanged" Color="Color.Primary" Label="Auto Scale" Class="mb-2" />
                    @if (!yAxisAutoScale)
                    {
                        <MudNumericField @bind-Value="yAxisMin" Label="Minimum" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" DebounceInterval="500" OnDebounceIntervalElapsed="ValidateAndUpdateYAxis" />
                        <MudNumericField @bind-Value="yAxisMax" Label="Maximum" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" DebounceInterval="500" OnDebounceIntervalElapsed="ValidateAndUpdateYAxis" />
                    }
                </MudPaper>

                @if (enableY2Axis)
                {
                    <!-- Secondary Y-Axis Range Control -->
                    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.VerticalAlignCenter" Size="Size.Small" /> Secondary Y-Axis Range
                        </MudText>
                        <MudDivider Class="mb-2" />
                        <MudSwitch @bind-Value="y2AxisAutoScale" @bind-Value:after="OnY2AxisAutoScaleChanged" Color="Color.Secondary" Label="Auto Scale" Class="mb-2" />
                        @if (!y2AxisAutoScale)
                        {
                            <MudNumericField @bind-Value="y2AxisMin" Label="Minimum" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" DebounceInterval="500" OnDebounceIntervalElapsed="ValidateAndUpdateY2Axis" />
                            <MudNumericField @bind-Value="y2AxisMax" Label="Maximum" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2" DebounceInterval="500" OnDebounceIntervalElapsed="ValidateAndUpdateY2Axis" />
                        }
                    </MudPaper>
                }

                @* Sensor Group Selector (only show if grouped format) *@
                @if (sensorGroups.Count > 0)
                {
                    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <MudText Typo="Typo.subtitle2" Style="color: #f1f5f9;">
                                <MudIcon Icon="@Icons.Material.Filled.DeviceHub" Size="Size.Small" /> Sensor Group Filter
                            </MudText>
                            <MudIconButton Icon="@(showSensorGroupFilter ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                           Size="Size.Small"
                                           OnClick="@(() => showSensorGroupFilter = !showSensorGroupFilter)" />
                        </div>
                        @if (showSensorGroupFilter)
                        {
                            <MudDivider Class="mb-2" />
                            <MudSelect @bind-Value="selectedSensorGroup" Label="Filter by Sensor Group" Variant="Variant.Outlined" Dense="true" AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="@("All")">All Groups</MudSelectItem>
                                @foreach (var group in sensorGroups)
                                {
                                    <MudSelectItem Value="@group">@group</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudPaper>
                }

                <!-- Primary Y-Axis Columns -->
                <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                        <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" /> Primary Y-Axis
                    </MudText>
                    <MudDivider Class="mb-2" />
                    <div style="max-height: 250px; overflow-y: auto;">
                        @foreach (var col in GetFilteredColumns())
                        {
                            <MudCheckBox Value="@selectedColumnsY1.Contains(col)"
                                         Color="Color.Primary"
                                         Dense="true"
                                         Label="@GetColumnDisplayName(col)"
                                         ValueChanged="@((bool val) => ToggleY1Column(col, val))" />
                        }
                    </div>
                </MudPaper>

                @if (enableY2Axis)
                {
                    <!-- Secondary Y-Axis Columns -->
                    <MudPaper Elevation="2" Class="pa-3 mb-4" Style="background-color: #1e293b;">
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                            <MudIcon Icon="@Icons.Material.Filled.Functions" Size="Size.Small" /> Secondary Y-Axis
                        </MudText>
                        <MudDivider Class="mb-2" />
                        <div style="max-height: 250px; overflow-y: auto;">
                            @foreach (var col in GetFilteredColumns())
                            {
                                <MudCheckBox Value="@selectedColumnsY2.Contains(col)"
                                             Color="Color.Secondary"
                                             Dense="true"
                                             Label="@GetColumnDisplayName(col)"
                                             ValueChanged="@((bool val) => ToggleY2Column(col, val))" />
                            }
                        </div>
                    </MudPaper>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mb-2"
                           StartIcon="@Icons.Material.Filled.ShowChart"
                           OnClick="UpdateChart">
                    Plot Chart
                </MudButton>

                <div class="tooltip-wrapper" data-tooltip="Remove all selected columns from the chart">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               FullWidth="true"
                               StartIcon="@Icons.Material.Filled.Clear"
                               OnClick="ClearAll">
                        Clear All Selections
                    </MudButton>
                </div>

                <MudDivider Class="my-4" />

                <MudExpansionPanels Elevation="0" Style="background-color: #1e293b;">
                    <MudExpansionPanel Text="Statistics & Export" Icon="@Icons.Material.Filled.Analytics" Style="background-color: #1e293b;">
                        @if (data.Count > 0)
                        {
                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: #cbd5e1;">
                                <strong>Total Records:</strong> @data.Count.ToString("N0")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: #cbd5e1;">
                                <strong>Numeric Columns:</strong> @numericColumns.Count
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: #cbd5e1;">
                                <strong>Time Column:</strong> @(timeColumn ?? "None detected")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-2" Style="color: #cbd5e1;">
                                <strong>Selected Y1:</strong> @selectedColumnsY1.Count
                            </MudText>
                            @if (enableY2Axis)
                            {
                                <MudText Typo="Typo.body2" Class="mb-2" Style="color: #cbd5e1;">
                                    <strong>Selected Y2:</strong> @selectedColumnsY2.Count
                                </MudText>
                            }

                            <MudDivider Class="my-3" />

                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="color: #f1f5f9;">
                                <MudIcon Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" /> Export Data
                            </MudText>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.FileDownload"
                                       FullWidth="true"
                                       OnClick="ExportAllData"
                                       Class="mb-2">
                                Export All Data
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.FilterAlt"
                                       FullWidth="true"
                                       OnClick="ExportVisibleData"
                                       Disabled="@(selectedColumnsY1.Count == 0 && selectedColumnsY2.Count == 0)">
                                Export Selected Columns
                            </MudButton>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="color: #cbd5e1;">
                                No data loaded yet
                            </MudText>
                        }
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="Statistical Analysis" Icon="@Icons.Material.Filled.Insights" Style="background-color: #1e293b;">
                        @if (data.Count > 0 && (selectedColumnsY1.Any() || selectedColumnsY2.Any()))
                        {
                            <MudSwitch @bind-Value="analyzeFullDataset" 
                                       @bind-Value:after="RecalculateStatistics" 
                                       Color="Color.Info" 
                                       Label="@(analyzeFullDataset ? "Analyzing Full Dataset" : "Analyzing Visible Data Only")" 
                                       Class="mb-3" />

                            @if (columnStatistics != null && columnStatistics.Any())
                            {
                                <MudText Typo="Typo.caption" Class="mb-3" Style="color: #94a3b8;">
                                    Analyzing @columnStatistics.First().Value.Count.ToString("N0") data points
                                </MudText>

                                @foreach (var stat in columnStatistics)
                                {
                                    <MudPaper Outlined="true" Class="pa-3 mb-3" Style="background-color: #1e293b; border-color: #334155;">
                                        <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #20818e;" Class="mb-2">
                                            @stat.Key
                                        </MudText>

                                        <MudSimpleTable Dense="true" Hover="true" Style="font-size: 0.85rem; background-color: #1e293b;">
                                            <tbody>
                                                <tr>
                                                    <td><strong>Count</strong></td>
                                                    <td>@stat.Value.Count.ToString("N0")</td>
                                                    <td><strong>Min</strong></td>
                                                    <td>@FormatNumber(stat.Value.Min)</td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Max</strong></td>
                                                    <td>@FormatNumber(stat.Value.Max)</td>
                                                    <td><strong>Range</strong></td>
                                                    <td>@FormatNumber(stat.Value.Range)</td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Mean</strong></td>
                                                    <td>@FormatNumber(stat.Value.Mean)</td>
                                                    <td><strong>Median</strong></td>
                                                    <td>@FormatNumber(stat.Value.Median)</td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Std Dev</strong></td>
                                                    <td>@FormatNumber(stat.Value.StandardDeviation)</td>
                                                    <td><strong>Variance</strong></td>
                                                    <td>@FormatNumber(stat.Value.Variance)</td>
                                                </tr>
                                                <tr>
                                                    <td><strong>25th %ile</strong></td>
                                                    <td>@FormatNumber(stat.Value.Percentile25)</td>
                                                    <td><strong>75th %ile</strong></td>
                                                    <td>@FormatNumber(stat.Value.Percentile75)</td>
                                                </tr>
                                                <tr>
                                                    <td><strong>95th %ile</strong></td>
                                                    <td>@FormatNumber(stat.Value.Percentile95)</td>
                                                    <td><strong>IQR</strong></td>
                                                    <td>@FormatNumber(stat.Value.IQR)</td>
                                                </tr>
                                                <tr>
                                                    <td><strong>Outliers</strong></td>
                                                    <td>
                                                        <MudChip T="string" Size="Size.Small" Color="@(stat.Value.OutlierCount > 0 ? Color.Warning : Color.Success)">
                                                            @stat.Value.OutlierCount
                                                        </MudChip>
                                                    </td>
                                                    <td><strong>MA(10)</strong></td>
                                                    <td>@(stat.Value.MovingAverage > 0 ? FormatNumber(stat.Value.MovingAverage) : "N/A")</td>
                                                </tr>
                                            </tbody>
                                        </MudSimpleTable>

                                        @if (stat.Value.OutlierCount > 0)
                                        {
                                            <MudText Typo="Typo.caption" Class="mt-2" Style="color: #94a3b8;">
                                                Outlier bounds: [@FormatNumber(stat.Value.LowerOutlierBound), @FormatNumber(stat.Value.UpperOutlierBound)]
                                            </MudText>
                                        }
                                    </MudPaper>
                                }

                                @if (columnStatistics.Count >= 2)
                                {
                                    <MudDivider Class="my-3" />
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600; color: #f1f5f9;" Class="mb-2">
                                        <MudIcon Icon="@Icons.Material.Filled.GridOn" Size="Size.Small" /> Correlation Matrix
                                    </MudText>

                                    @if (correlationMatrix != null)
                                    {
                                        <MudPaper Outlined="true" Class="pa-2" Style="background-color: #1e293b; border-color: #334155;">
                                            <MudSimpleTable Dense="true" Style="font-size: 0.8rem; background-color: #1e293b;">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        @foreach (var col in correlationMatrix.Keys)
                                                        {
                                                            <th style="text-align: center; font-size: 0.75rem;">@GetShortColumnName(col)</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var row in correlationMatrix)
                                                    {
                                                        <tr>
                                                            <td><strong style="font-size: 0.75rem;">@GetShortColumnName(row.Key)</strong></td>
                                                            @foreach (var col in correlationMatrix.Keys)
                                                            {
                                                                var corr = row.Value[col];
                                                                var color = GetCorrelationColor(corr);
                                                                <td style="text-align: center; background-color: @color; padding: 4px;">
                                                                    <span style="font-size: 0.75rem;">@corr.ToString("F3")</span>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </MudSimpleTable>
                                            <MudText Typo="Typo.caption" Class="mt-2" Style="color: #94a3b8;">
                                                Values range from -1 (negative) to +1 (positive correlation)
                                            </MudText>
                                        </MudPaper>
                                    }
                                }
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Style="color: #cbd5e1;">
                                Select columns to view statistical analysis
                            </MudText>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </MudPaper>
        }

        <!-- Toggle button when sidebar is hidden -->
        @if (!showSidebar)
        {
            <div style="position: absolute; left: 10px; top: 10px; z-index: 1000;">
                <MudTooltip Text="Show sidebar">
                    <MudFab Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.ChevronRight"
                            Size="Size.Small"
                            OnClick="@(() => showSidebar = !showSidebar)" />
                </MudTooltip>
            </div>
        }

        <!-- Chart Area -->
        <MudPaper Elevation="0" Class="flex-grow-1 pa-4" Style="background-color: #0f172a; min-width: 0; overflow: hidden;">
            @if (isLoading)
            {
                <MudPaper Elevation="3" Class="pa-4" Style="height: 100%; border-radius: 12px; background-color: #1e293b;">
                    <div class="d-flex flex-column align-center justify-center" style="height: 100%;">
                        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                        <MudText Typo="Typo.h6" Class="mt-4">@statusMessage</MudText>
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="80%" Height="300px" Class="mt-4" />
                    </div>
                </MudPaper>
            }
            else if (data.Count == 0)
            {
                <MudPaper Elevation="3" Class="pa-4" Style="height: 100%; border-radius: 12px; background-color: #1e293b;">
                    <div class="d-flex flex-column align-center justify-center" style="height: 100%;">
                        <MudIcon Icon="@Icons.Material.Filled.BarChart" Style="font-size: 120px; color: #20818e;" />
                        <MudText Typo="Typo.h5" Class="mt-4" Style="color: #f1f5f9;">No Data Loaded</MudText>
                        <MudText Typo="Typo.body1" Style="color: #cbd5e1;">Upload a CSV file from the left sidebar to begin visualization</MudText>
                    </div>
                </MudPaper>
            }
            else
            {
                <div style="@GetFullscreenContainerStyle()">
                    @if (isChartFullscreen)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.FullscreenExit"
                                    Style="position: fixed; top: 20px; right: 20px; z-index: 10001; background-color: rgba(30,41,59,0.9); border-radius: 8px;"
                                    Color="Color.Primary"
                                    Size="Size.Large"
                                    OnClick="ToggleChartFullscreen" />
                    }

                    <!-- Data View Button -->
                    <div style="@(isChartFullscreen ? "position: fixed; top: 20px; left: 20px; z-index: 10001;" : "position: absolute; top: 30px; left: 400px; z-index: 1000;")">
                        <MudTooltip Text="View and analyze data with Excel-like formulas">
                            <MudFab Color="Color.Primary"
                                    StartIcon="@Icons.Material.Filled.TableChart"
                                    Size="Size.Small"
                                    Href="/data-view"
                                    Label="Data View" />
                        </MudTooltip>
                    </div>

                    @if (chartLayout == "single")
                    {
                        <MudPaper Elevation="3" Class="pa-4" Style="@GetChartPaperStyle()" @oncontextmenu="HandleChartRightClick">
                            <div id="chart" style="width: 100%; height: 100%;"></div>
                        </MudPaper>
                    }
                    else
                    {
                        <div style="@(isChartFullscreen ? "width: 100%; height: 100%;" : "height: 100%;")">
                            @RenderSplitCharts()
                        </div>
                    }
                </div>
            }
        </MudPaper>

        <!-- Comments Panel -->
        @if (showCommentsPanel && currentSessionId.HasValue)
        {
            <MudPaper Elevation="4" Class="pa-4" Style="width: 380px; overflow-y: auto; border-radius: 0; background-color: #1e293b;">
                <CommentsPanel SessionId="@currentSessionId.Value" />
            </MudPaper>
        }

        <!-- Right Customization Panel -->
        @if (showCustomizationPanel)
        {
            <div style="position: fixed; left: @(panelX)px; top: @(panelY)px; width: 400px; max-height: 550px; background-color: #1e293b; border: 2px solid #20818e; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.2); z-index: 9999; overflow: hidden;" @onclick:stopPropagation="true">
                <ChartCustomizationPanel ChartLayout="@chartLayout"
                                        @bind-SelectedChartForAxisEdit="selectedChartForAxisEdit"
                                        @bind-SelectedChartForAxisEdit:after="OnSelectedChartChanged"
                                        OnAxisNameChanged="@AxisNameChangedCallback"
                                        @bind-CustomColors="customColors"
                                        @bind-ChartTheme="chartTheme"
                                        @bind-ColorPalette="colorPalette"
                                        @bind-ChartType="defaultChartType"
                                        @bind-ShowTitle="showTitle"
                                        @bind-TitleText="titleText"
                                        @bind-TitleColor="titleColor"
                                        @bind-TitleFontSize="titleFontSize"
                                        @bind-TitleFontWeight="titleFontWeight"
                                        @bind-TitleAlignment="titleAlignment"
                                        @bind-TitleTop="titleTop"
                                        @bind-TitleLeft="titleLeft"
                                        @bind-ShowSubtitle="showSubtitle"
                                        @bind-SubtitleText="subtitleText"
                                        @bind-SubtitleColor="subtitleColor"
                                        @bind-SubtitleFontSize="subtitleFontSize"
                                        @bind-ShowLegend="showLegend"
                                        @bind-LegendPosition="legendPosition"
                                        @bind-LegendOrient="legendOrient"
                                        @bind-LegendFontSize="legendFontSize"
                                        @bind-LegendTextColor="legendTextColor"
                                        @bind-LegendBackgroundColor="legendBackgroundColor"
                                        @bind-LegendBorderColor="legendBorderColor"
                                        @bind-LegendBorderWidth="legendBorderWidth"
                                        @bind-LegendBorderRadius="legendBorderRadius"
                                        @bind-LegendPadding="legendPadding"
                                        @bind-LegendItemGap="legendItemGap"
                                        @bind-XAxisName="xAxisName"
                                        @bind-XAxisNameLocation="xAxisNameLocation"
                                        @bind-XAxisNameGap="xAxisNameGap"
                                        @bind-XAxisNameFontSize="xAxisNameFontSize"
                                        @bind-XAxisNameColor="xAxisNameColor"
                                        @bind-XAxisLabelColor="xAxisLabelColor"
                                        @bind-XAxisLabelRotate="xAxisLabelRotate"
                                        @bind-XAxisLabelFontSize="xAxisLabelFontSize"
                                        @bind-XAxisLabelMargin="xAxisLabelMargin"
                                        @bind-XAxisShowTick="xAxisShowTick"
                                        @bind-XAxisTickLength="xAxisTickLength"
                                        @bind-XAxisTickColor="xAxisTickColor"
                                        @bind-YAxisName="yAxisName"
                                        @bind-YAxisNameLocation="yAxisNameLocation"
                                        @bind-YAxisNameGap="yAxisNameGap"
                                        @bind-YAxisNameFontSize="yAxisNameFontSize"
                                        @bind-YAxisNameColor="yAxisNameColor"
                                        @bind-YAxisLabelColor="yAxisLabelColor"
                                        @bind-YAxisAutoScale="yAxisAutoScale"
                                        @bind-YAxisMin="yAxisMin"
                                        @bind-YAxisMax="yAxisMax"
                                        @bind-YAxisLabelFontSize="yAxisLabelFontSize"
                                        @bind-YAxisShowTick="yAxisShowTick"
                                        @bind-YAxisTickLength="yAxisTickLength"
                                        @bind-YAxisTickColor="yAxisTickColor"
                                        @bind-UseLogScale="useLogScale"
                                        @bind-Y2AxisName="y2AxisName"
                                        @bind-Y2AxisNameFontSize="y2AxisNameFontSize"
                                        @bind-Y2AxisNameColor="y2AxisNameColor"
                                        @bind-Y2AxisLabelFontSize="y2AxisLabelFontSize"
                                        @bind-Y2AxisLabelColor="y2AxisLabelColor"
                                        @bind-ShowXAxisLine="showXAxisLine"
                                        @bind-ShowYAxisLine="showYAxisLine"
                                        @bind-AxisLineColor="axisLineColor"
                                        @bind-AxisLineWidth="axisLineWidth"
                                        @bind-ShowHorizontalGrid="showHorizontalGrid"
                                        @bind-ShowVerticalGrid="showVerticalGrid"
                                        @bind-HorizontalGridInterval="horizontalGridInterval"
                                        @bind-VerticalGridInterval="verticalGridInterval"
                                        @bind-GridLineColor="gridLineColor"
                                        @bind-GridLineWidth="gridLineWidth"
                                        @bind-GridLineStyle="gridLineStyle"
                                        @bind-GridTop="gridTop"
                                        @bind-GridBottom="gridBottom"
                                        @bind-GridLeft="gridLeft"
                                        @bind-GridRight="gridRight"
                                        @bind-GridBorderColor="gridBorderColor"
                                        @bind-GridBorderWidth="gridBorderWidth"
                                        @bind-ChartBackgroundColor="chartBackgroundColor"
                                        @bind-GridBackgroundColor="gridBackgroundColor"
                                        @bind-LineStyle="lineStyle"
                                        @bind-LineOpacity="lineOpacity"
                                        @bind-AreaOpacity="areaOpacity"
                                        @bind-ShowDataPointMarkers="showDataPointMarkers"
                                        @bind-SymbolType="symbolType"
                                        @bind-SymbolSize="symbolSize"
                                        @bind-EnableSmoothLines="enableSmoothLines"
                                        @bind-AnimationDuration="animationDuration"
                                        @bind-AnimationEasing="animationEasing"
                                        @bind-TooltipTrigger="tooltipTrigger"
                                        @bind-TooltipAxisPointerType="tooltipAxisPointerType"
                                        @bind-TooltipBackgroundColor="tooltipBackgroundColor"
                                        @bind-TooltipBorderColor="tooltipBorderColor"
                                        @bind-TooltipBorderWidth="tooltipBorderWidth"
                                        @bind-TooltipBorderRadius="tooltipBorderRadius"
                                        @bind-TooltipPadding="tooltipPadding"
                                        @bind-TooltipTextColor="tooltipTextColor"
                                        @bind-TooltipFontSize="tooltipFontSize"
                                        @bind-ShowDataLabels="showDataLabels"
                                        @bind-DataLabelPosition="dataLabelPosition"
                                        @bind-DataLabelColor="dataLabelColor"
                                        @bind-DataLabelFontSize="dataLabelFontSize"
                                        @bind-DataLabelFontWeight="dataLabelFontWeight"
                                        @bind-DataLabelBackgroundColor="dataLabelBackgroundColor"
                                        @bind-DataLabelBorderColor="dataLabelBorderColor"
                                        @bind-DataLabelBorderWidth="dataLabelBorderWidth"
                                        @bind-DataLabelBorderRadius="dataLabelBorderRadius"
                                        @bind-DataLabelPadding="dataLabelPadding"
                                        @bind-DataLabelFormatter="dataLabelFormatter"
                                        @bind-DataLabelRotate="dataLabelRotate"
                                        @bind-DataLabelShowOnHighlight="dataLabelShowOnHighlight"
                                        @bind-ShowDataZoomSlider="showDataZoomSlider"
                                        @bind-ShowDataZoomInside="showDataZoomInside"
                                        @bind-ZoomSyncChart1="zoomSyncChart1"
                                        @bind-ZoomSyncChart2="zoomSyncChart2"
                                        @bind-ZoomSyncChart3="zoomSyncChart3"
                                        @bind-ZoomSyncChart4="zoomSyncChart4"
                                        @bind-ZoomSyncChart5="zoomSyncChart5"
                                        @bind-ZoomSyncChart6="zoomSyncChart6"
                                        @bind-ZoomSyncChart7="zoomSyncChart7"
                                        @bind-ZoomSyncChart8="zoomSyncChart8"
                                        @bind-ZoomSyncAllCharts="zoomSyncAllCharts"
                                        @bind-DataZoomHeight="dataZoomHeight"
                                        @bind-DataZoomBackgroundColor="dataZoomBackgroundColor"
                                        @bind-DataZoomFillerColor="dataZoomFillerColor"
                                        @bind-DataZoomBorderColor="dataZoomBorderColor"
                                        @bind-ShowToolbox="showToolbox"
                                        @bind-ToolboxShowSaveAsImage="toolboxShowSaveAsImage"
