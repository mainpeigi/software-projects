    private void AddCalculatedColumn()
    {
        if (string.IsNullOrEmpty(calcColumnName) || string.IsNullOrEmpty(calcColumn1))
            return;

        bool isSingleColumnOp = calcOperation == "max" || calcOperation == "min" || calcOperation == "avg";
        
        if (!isSingleColumnOp && string.IsNullOrEmpty(calcColumn2))
            return;

        // Check if column name already exists
        if (numericColumns.Contains(calcColumnName) || calculatedColumns.Contains(calcColumnName))
        {
            Console.WriteLine($"Column '{calcColumnName}' already exists");
            return;
        }

        // Store the calculation formula instead of pre-calculated data
        calculatedColumns.Add(calcColumnName);
        numericColumns.Add(calcColumnName);

        // Store the formula for this calculated column
        if (!calculationFormulas.ContainsKey(calcColumnName))
        {
            calculationFormulas[calcColumnName] = new CalculationFormula
            {
                Column1 = calcColumn1,
                Column2 = isSingleColumnOp ? "" : calcColumn2,
                Operation = calcOperation
            };
        }

        // Clear form
        calcColumnName = "";
        calcColumn1 = "";
        calcColumn2 = "";

        SaveCurrentState();
        StateHasChanged();
    }

    private void RemoveCalculatedColumn(string columnName)
    {
        calculatedColumns.Remove(columnName);
        calculationFormulas.Remove(columnName);
        calculationCache.Remove(columnName);
        numericColumns.Remove(columnName);
        selectedColumnsY1.Remove(columnName);
        selectedColumnsY2.Remove(columnName);

        SaveCurrentState();
        UpdateChart();
    }

    private async void UpdateChart()
    {
        if (chartUpdateDebounce > 0)
        {
            debounceTimer?.Dispose();
            debounceTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () => await UpdateChartInternal());
            }, null, chartUpdateDebounce, Timeout.Infinite);
        }
        else
        {
            await UpdateChartInternal();
        }
    }

    private async Task UpdateChartInternal()
    {
        if (data.Count == 0) return;

        try
        {
            await DisposeAllCharts();

            // Ensure DOM is rendered before initializing charts
            StateHasChanged();
            await Task.Yield();
            await Task.Delay(50);

            var plotData = GetSampledData();

            // Get time values for X-axis
            List<string> xAxisLabels;
            if (!string.IsNullOrEmpty(timeColumn))
            {
                // Format time to MM:SS
                xAxisLabels = plotData.Select(d =>
                {
                    var timeValue = d.GetValue(timeColumn) ?? "";
                    return CsvService.FormatTimeToMinutesSeconds(timeValue);
                }).ToList();
            }
            else
            {
                // Use row index if no time column found
                xAxisLabels = Enumerable.Range(1, plotData.Count).Select(i => i.ToString()).ToList();
            }

            if (chartLayout == "single")
            {
                // Render single chart with all selected data
                await RenderChart("chart", plotData, xAxisLabels, selectedColumnsY1, selectedColumnsY2);
            }
            else
            {
                // For split views, use manual chart assignments
                var allColumns = selectedColumnsY1.Concat(selectedColumnsY2).Distinct().ToList();
                var chartCount = GetChartCount();

                // Ensure all selected columns have assignments
                foreach (var col in allColumns)
                {
                    if (!chartAssignments.ContainsKey(col))
                    {
                        chartAssignments[col] = 1; // Default to chart 1
                    }
                }

                // Render each chart with its assigned columns
                int colorOffset = 0;
                for (int i = 1; i <= chartCount; i++)
                {
                    var chartNum = i;
                    var chartY1 = selectedColumnsY1.Where(c => chartAssignments.GetValueOrDefault(c, 1) == chartNum).ToHashSet();
                    var chartY2 = selectedColumnsY2.Where(c => chartAssignments.GetValueOrDefault(c, 1) == chartNum).ToHashSet();

                    // Pass color offset so each chart gets unique colors
                    await RenderChart($"chart{chartNum}", plotData, xAxisLabels, chartY1, chartY2, colorOffset);

                    // Update offset for next chart (total lines in current chart)
                    colorOffset += chartY1.Count + chartY2.Count;
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chart error: {ex.Message}");
        }
    }

