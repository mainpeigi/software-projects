    private async Task ProcessPastedText()
    {
        try
        {
            // Read textarea value directly from DOM - no Blazor binding for large text
            var textContent = await JS.InvokeAsync<string>("getTextAreaValue", pasteTextArea);

            if (string.IsNullOrWhiteSpace(textContent))
            {
                pasteErrorMessage = "Please paste some data first";
                return;
            }

            isPasting = true;
            pasteErrorMessage = null;
            pastedDataInfo = null;
            statusMessage = "Parsing pasted data...";
            StateHasChanged();

            // Convert text to stream and use CsvService (same as file loading)
            // This is WAY faster than manual parsing with StateHasChanged every 50 rows
            using var memoryStream = new MemoryStream(System.Text.Encoding.UTF8.GetBytes(textContent));
            var result = await CsvService.ParseGenericCsvAsync(memoryStream, autoDetectDateColumns);

            // Update state with parsed data
            data = result.data;
            availableColumns = result.numericColumns;
            numericColumns = result.numericColumns;
            timeColumn = result.timeColumn;
            columnToGroupMapping = result.columnGroups;
            sensorGroups = result.sensorGroups;
            columnUnits = result.columnUnits;

            selectedColumnsY1.Clear();
            selectedColumnsY2.Clear();
            calculationCache.Clear();

            rangeStartPoint = 0;
            rangeEndPoint = Math.Min(data.Count - 1, rangeStartPoint + MAX_RANGE_SIZE);

            selectedFile = null;
            fileLoaded = true;
            
            // Set a unique identifier for pasted data to isolate its state
            lastLoadedFileName = $"PastedData_{DateTime.Now:yyyyMMdd_HHmmss}";
            lastLoadedFileTimestamp = DateTime.Now;
            StateService.SetCurrentFile(lastLoadedFileName);
            
            pastedDataInfo = $"Pasted: {data.Count:N0} rows, {numericColumns.Count} numeric columns";
            statusMessage = $"Loaded {data.Count:N0} records from clipboard!";

            // Auto-detect units for columns without units
            AutoDetectColumnUnits();
            detectedColumnUnits = new Dictionary<string, string>(columnUnits);

            // Load preferences
            var preferences = await PreferencesService.LoadAsync();
            samplingLevel = preferences.DefaultSamplingLevel;
            chartLayout = preferences.DefaultChartLayout;

            // Clear the textarea after successful load
            await JS.InvokeVoidAsync("clearTextArea", pasteTextArea);
        }
        catch (Exception ex)
        {
            pasteErrorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isPasting = false;
            StateHasChanged();
        }
    }

