    private double GetAverageValue(string column)
    {
        double sum = 0;
        int count = 0;
        var sampledData = GetSampledData();

        foreach (var row in sampledData)
        {
            var val = row.GetNumericValueOrNull(column);
            if (val != null && val is double d)
            {
                sum += d;
                count++;
            }
        }

        return count > 0 ? sum / count : 0;
    }

    private List<string> GetColorPalette()
    {
        // Custom colors take priority
        if (customColors.Count > 0)
        {
            return customColors.ToList();
        }

        // Color palette determines line colors (independent of theme)
        // Theme only affects chart background, axes, text, etc. via echarts.init(dom, theme)
        return colorPalette switch
        {
            "cool" => new List<string> { "#5B8FF9", "#5AD8A6", "#5D7092", "#6DC8EC", "#945FB9", "#FF9845", "#1E9493", "#FF99C3", "#4169E1", "#00CED1", "#7B68EE", "#4682B4", "#20B2AA", "#87CEEB", "#6495ED", "#00BFFF", "#1E90FF", "#4169E1", "#0000CD", "#191970" },
