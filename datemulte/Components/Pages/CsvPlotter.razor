    // Helper method to get ECharts series properties based on chart type
    private (string type, bool isStep, bool isStacked, bool showArea, bool isSpecialChart) GetChartTypeProperties()
    {
        return defaultChartType switch
        {
            "line" => ("line", false, false, false, false),
            "area" => ("line", false, false, true, false),
            "stepLine" => ("line", true, false, false, false),
            "stepArea" => ("line", true, false, true, false),
            "bar" => ("bar", false, false, false, false),
            "stackedBar" => ("bar", false, true, false, false),
            "stackedArea" => ("line", false, true, true, false),
            "scatter" => ("scatter", false, false, false, false),
            "pie" => ("pie", false, false, false, true),
            "radar" => ("radar", false, false, false, true),
            "candlestick" => ("candlestick", false, false, false, true),
            "heatmap" => ("heatmap", false, false, false, true),
            "donut" => ("pie", false, false, false, true),
            "rose" => ("pie", false, false, false, true),
            "waterfall" => ("bar", false, false, false, true),
