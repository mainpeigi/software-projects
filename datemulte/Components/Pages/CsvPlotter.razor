        }
        else
        {
            // Otherwise, add only the individually selected charts
            if (zoomSyncChart1) syncCharts.Add(1);
            if (zoomSyncChart2) syncCharts.Add(2);
            if (zoomSyncChart3) syncCharts.Add(3);
            if (zoomSyncChart4) syncCharts.Add(4);
            if (zoomSyncChart5) syncCharts.Add(5);
            if (zoomSyncChart6) syncCharts.Add(6);
            if (zoomSyncChart7) syncCharts.Add(7);
            if (zoomSyncChart8) syncCharts.Add(8);
        }
        var syncChartsJson = System.Text.Json.JsonSerializer.Serialize(syncCharts);

        // Use a timeout to prevent hanging on JS interop
        using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
        try
        {
            await JS.InvokeAsync<object>("echartsInterop.initOrUpdateChart",
                cts.Token, chartId, jsonString, themeParam, syncChartsJson, tooltipFormatter.Trim(), decimalPlaces);
        }
        catch (TaskCanceledException)
        {
            Console.WriteLine($"Chart initialization timed out for {chartId}. ECharts may not have loaded properly.");
            statusMessage = "Chart loading timed out. Please refresh the page.";
            StateHasChanged();
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Chart JS error for {chartId}: {ex.Message}");
            statusMessage = $"Chart error: {ex.Message}";
            StateHasChanged();
        }
    }

    private List<GenericCsvRow> GetSampledData()
    {
        var filteredData = ApplyFilters(data);

        if(dataControlMode == "range")
        {
            return GetRangedData(filteredData);
        }

        if(samplingLevel == 0 || filteredData.Count <= samplingLevel)
        {
            return filteredData;
        }

        int step = filteredData.Count / samplingLevel;
        return filteredData.Where((x, i) => i % step == 0).ToList();
    }

    private List<GenericCsvRow> GetRangedData(List<GenericCsvRow>? sourceData = null)
    {
        var workingData = sourceData ?? ApplyFilters(data);

        if(workingData.Count == 0)
            return workingData;

        int start = Math.Max(0, rangeStartPoint);
        int end = Math.Min(workingData.Count - 1, rangeEndPoint);

        if(start >=end)
            return workingData;

        int count = end - start + 1;
        return workingData.Skip(start).Take(count).ToList();
    }

    private int GetMaxEndPoint()
    {
        if (data.Count == 0)
            return 0;

        int maxEnd = rangeStartPoint + MAX_RANGE_SIZE;
        return Math.Min(maxEnd, data.Count - 1);
    }

    private int GetSelectedRangeCount()
    {
        if (data.Count == 0)
            return 0;

        int start = Math.Max(0, rangeStartPoint);
        int end = Math.Min(data.Count - 1, rangeEndPoint);
        return Math.Max(0, end - start + 1);
    }

    private void OnRangeStartChanged(int newStart)
    {
        rangeStartPoint = Math.Max(0, Math.Min(newStart, data.Count - 1));
        
        if (rangeEndPoint < rangeStartPoint)
        {
            rangeEndPoint = rangeStartPoint;
        }
        
        if (rangeEndPoint > rangeStartPoint + MAX_RANGE_SIZE)
        {
            rangeEndPoint = rangeStartPoint + MAX_RANGE_SIZE;
        }
        
        rangeEndPoint = Math.Min(rangeEndPoint, data.Count - 1);
        
        calculationCache.Clear();
        
        SaveCurrentState();
        UpdateChart();
    }

    private void OnRangeEndChanged(int newEnd)
    {
        int maxEnd = GetMaxEndPoint();
        rangeEndPoint = Math.Max(rangeStartPoint, Math.Min(newEnd, maxEnd));
        
        calculationCache.Clear();
        
        SaveCurrentState();
        UpdateChart();
    }

    private void ResetRange()
    {
        rangeStartPoint = 0;
        rangeEndPoint = data.Count > 0 ? data.Count - 1 : 0;
        calculationCache.Clear();
        SaveCurrentState();
        UpdateChart();
    }

    private void OnDataControlModeChanged()
    {
        UpdateChart();
    }

    private List<object?> GetColumnValues(List<GenericCsvRow> plotData, string columnName, int yAxisIndex = 0)
    {
        // Determine if filtering should be applied based on axis index
        bool shouldFilter = false;
        int filterMin = 0;
        int filterMax = 0;

        if (yAxisIndex == 0 && !yAxisAutoScale && yAxisMin != yAxisMax)
        {
            shouldFilter = true;
            filterMin = yAxisMin;
            filterMax = yAxisMax;
        }
        else if (yAxisIndex == 1 && !y2AxisAutoScale && y2AxisMin != y2AxisMax)
        {
            shouldFilter = true;
            filterMin = y2AxisMin;
            filterMax = y2AxisMax;
        }
        
        if (calculationFormulas.ContainsKey(columnName))
        {
            var cacheKey = $"{columnName}_{plotData.Count}_{rangeStartPoint}_{rangeEndPoint}_{samplingLevel}_{shouldFilter}_{filterMin}_{filterMax}";

            if (cacheCalculatedColumns && calculatedColumnObjectCache.ContainsKey(cacheKey))
            {
                return calculatedColumnObjectCache[cacheKey];
            }

            var formula = calculationFormulas[columnName];
            var result = new List<object?>();

            if (formula.Operation == "max" || formula.Operation == "min" || formula.Operation == "avg")
            {
                var allValues = plotData.Select(row => row.GetNumericValue(formula.Column1)).ToList();
                double constantValue = formula.Operation switch
                {
                    "max" => allValues.Max(),
                    "min" => allValues.Min(),
                    "avg" => allValues.Average(),
                    _ => 0
                };

                for (int i = 0; i < plotData.Count; i++)
                {
                    if (shouldFilter && (constantValue < filterMin || constantValue > filterMax))
                    {
                        result.Add(null);
                    }
                    else
                    {
                        result.Add(constantValue);
                    }
                }
            }
            else
            {
                for (int i = 0; i < plotData.Count; i++)
                {
                    var val1 = plotData[i].GetNumericValue(formula.Column1);
                    var val2 = plotData[i].GetNumericValue(formula.Column2);
                    double calculated = 0;

                    switch (formula.Operation)
                    {
                        case "+":
                            calculated = val1 + val2;
                            break;
                        case "-":
                            calculated = val1 - val2;
                            break;
                        case "*":
                            calculated = val1 * val2;
                            break;
                        case "/":
                            calculated = val2 != 0 ? val1 / val2 : 0;
                            break;
                        case "pct_of":
                            calculated = val2 != 0 ? (val1 / val2) * 100 : 0;
                            break;
                        case "pct_change":
                            calculated = val2 != 0 ? ((val1 - val2) / val2) * 100 : 0;
                            break;
                        case "%":
                            calculated = val2 != 0 ? (val1 / val2) * 100 : 0;
                            break;
                    }

                    if (shouldFilter && (calculated < filterMin || calculated > filterMax))
                    {
                        result.Add(null);
                    }
                    else
                    {
                        result.Add(calculated);
                    }
                }
            }

            if (cacheCalculatedColumns)
            {
                calculatedColumnObjectCache[cacheKey] = result;
            }

            return result;
        }

        var values = new List<object?>();
        int nullCount = 0;
        int firstDataIndex = -1;
        
        for (int i = 0; i < plotData.Count; i++)
        {
            var value = plotData[i].GetNumericValueOrNull(columnName);
            
            if (shouldFilter && value != null)
            {
                double numValue = (double)value;
                if (numValue < filterMin || numValue > filterMax)
                {
                    value = null;
                }
            }
            
            values.Add(value);
            if (value == null)
            {
                nullCount++;
            }
            else if (firstDataIndex == -1)
            {
                firstDataIndex = i;
            }
        }
        
        double sparsityRatio = (double)nullCount / plotData.Count;
        bool dataStartsLate = firstDataIndex > plotData.Count * 0.3;
        
        if (shouldFilter)
        {
            Console.WriteLine($"GetColumnValues for '{columnName}': Using dense format for filtering (sparsity={sparsityRatio:P1}), {values.Count} values");
            return values;
        }
        
        if (sparsityRatio > 0.7 || (sparsityRatio > 0.3 && dataStartsLate))
        {
            var coordinatePairs = new List<object?>();
            for (int i = 0; i < plotData.Count; i++)
            {
                if (values[i] != null)
                {
                    coordinatePairs.Add(new[] { i, (double)values[i]! });
                }
            }
            
            Console.WriteLine($"GetColumnValues for '{columnName}': Sparse data (sparsity={sparsityRatio:P1}, first data at row {firstDataIndex}), {coordinatePairs.Count} data points out of {plotData.Count} rows");
            return coordinatePairs;
        }
        else
        {
            Console.WriteLine($"GetColumnValues for '{columnName}': Dense data (sparsity={sparsityRatio:P1}), {values.Count} values");
            return values;
        }
    }

    private void AutoDetectColumnUnits()
    {
        // Don't clear - preserve units loaded from CSV file
        // columnUnits.Clear();

        foreach (var column in numericColumns)
        {
            // Skip if this column already has a unit from the CSV file
            if (columnUnits.ContainsKey(column))
                continue;

            var match1 = System.Text.RegularExpressions.Regex.Match(column, @"\(([^)]+)\)");
            if (match1.Success)
            {
                columnUnits[column] = match1.Groups[1].Value;
                continue;
            }

            var match2 = System.Text.RegularExpressions.Regex.Match(column, @"\[([^\]]+)\]");
            if (match2.Success)
            {
                columnUnits[column] = match2.Groups[1].Value;
                continue;
            }
            
            var lowerCol = column.ToLower();
            if (lowerCol.Contains("temp"))
            {
                columnUnits[column] = temperatureUnit;
            }
            else if (lowerCol.Contains("flow"))
            {
                columnUnits[column] = flowUnit;
            }
            else if (lowerCol.Contains("pressure") || lowerCol.Contains("press"))
            {
                columnUnits[column] = pressureUnit;
            }
            else if (lowerCol.Contains("nano"))
            {
                columnUnits[column] = "nm";
            }
            else if (lowerCol.Contains("voltage") || lowerCol.Contains("volt"))
            {
                columnUnits[column] = voltageUnit;
            }
            else if (lowerCol.Contains("current"))
            {
                columnUnits[column] = currentUnit;
            }
            else if (lowerCol.Contains("power"))
            {
                columnUnits[column] = powerUnit;
            }
            else if (lowerCol.Contains("speed") || lowerCol.Contains("velocity"))
            {
                columnUnits[column] = speedUnit;
            }
            else if (lowerCol.Contains("distance") || lowerCol.Contains("length"))
            {
                columnUnits[column] = distanceUnit;
            }
            else if (lowerCol.Contains("force"))
            {
                columnUnits[column] = forceUnit;
            }
        }
    }
    
    private string? ExtractUnit(string columnName)
    {
        // Only extract unit from the column name itself, not from dictionary
        // This is used to detect if the column name already contains a unit
        var match1 = System.Text.RegularExpressions.Regex.Match(columnName, @"\(([^)]+)\)");
        if (match1.Success)
            return match1.Groups[1].Value;

        var match2 = System.Text.RegularExpressions.Regex.Match(columnName, @"\[([^\]]+)\]");
        if (match2.Success)
            return match2.Groups[1].Value;

        return null;
    }

    private string FormatNumber(double value)
    {
        // Apply scientific notation if enabled and value is large/small
        if (useScientificNotation && (Math.Abs(value) >= 1e6 || (Math.Abs(value) < 1e-6 && value != 0)))
        {
            return value.ToString($"E{decimalPlaces}");
        }

        // Otherwise use normal decimal formatting
        return value.ToString($"F{decimalPlaces}");
    }

