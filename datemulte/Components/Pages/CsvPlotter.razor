    private async Task RenderChart(string chartId, List<GenericCsvRow> plotData, List<string> xAxisLabels,
        HashSet<string> y1Columns, HashSet<string> y2Columns, int colorOffset = 0)
    {
        var series = new List<object>();

        // Build Y1 axis label with each column name and its unit
        string y1Label = "";
        if (y1Columns.Count > 0)
        {
            var columnLabels = new List<string>();
            foreach (var col in y1Columns)
            {
                // First check if user has set a custom unit in columnUnits (from dialog)
                string? unit = columnUnits.ContainsKey(col) ? columnUnits[col] : null;

                if (!string.IsNullOrEmpty(unit))
                {
                    // User has set a unit, strip any existing unit from column name and use the custom one
                    string colNameWithoutUnit = System.Text.RegularExpressions.Regex.Replace(col, @"\s*[\(\[].+?[\)\]]", "").Trim();
                    columnLabels.Add($"{colNameWithoutUnit} [{unit}]");
                }
                else
                {
                    // No custom unit, check if column name already has a unit embedded in it
                    string? unitFromName = ExtractUnit(col);

                    if (!string.IsNullOrEmpty(unitFromName))
                    {
                        // Column name already has unit, don't add it again
                        columnLabels.Add(col);
                    }
                    else
                    {
                        columnLabels.Add(col);
                    }
                }
            }
            if (columnLabels.Count <= 3)
            {
                y1Label = string.Join(", ", columnLabels);
            }
            else
            {
                y1Label = string.Join(", ", columnLabels.Take(3)) + $", ... ({columnLabels.Count} total)";
            }
        }
        else
        {
            y1Label = "Value";
        }

        // Build Y2 axis label with each column name and its unit
        string y2Label = "";
        if (y2Columns.Count > 0)
        {
            var columnLabels = new List<string>();
            foreach (var col in y2Columns)
            {
                // First check if user has set a custom unit in columnUnits (from dialog)
                string? unit = columnUnits.ContainsKey(col) ? columnUnits[col] : null;

                if (!string.IsNullOrEmpty(unit))
                {
                    // User has set a unit, strip any existing unit from column name and use the custom one
                    string colNameWithoutUnit = System.Text.RegularExpressions.Regex.Replace(col, @"\s*[\(\[].+?[\)\]]", "").Trim();
                    columnLabels.Add($"{colNameWithoutUnit} [{unit}]");
                }
                else
                {
                    // No custom unit, check if column name already has a unit embedded in it
                    string? unitFromName = ExtractUnit(col);

                    if (!string.IsNullOrEmpty(unitFromName))
                    {
                        // Column name already has unit, don't add it again
                        columnLabels.Add(col);
                    }
                    else
                    {
                        columnLabels.Add(col);
                    }
                }
            }

            if (columnLabels.Count <= 3)
            {
                y2Label = string.Join(", ", columnLabels);
            }
            else
            {
                y2Label = string.Join(", ", columnLabels.Take(3)) + $", ... ({columnLabels.Count} total)";
            }
        }
        else
        {
            y2Label = "Value";
        }

        // Get colors from palette
        var colors = GetColorPalette();

        // Check if this is a special chart type that needs completely different rendering
        var (chartType, isStep, isStacked, showArea, isSpecialChart) = GetChartTypeProperties();

        if (isSpecialChart)
        {
            var allSelectedColumns = y1Columns.Concat(y2Columns).ToList();

            object? specialOption = defaultChartType switch
            {
                "pie" => BuildPieChartOption(allSelectedColumns, colors),
                "radar" => BuildRadarChartOption(allSelectedColumns, colors),
                "heatmap" => BuildHeatmapChartOption(allSelectedColumns, colors),
                "candlestick" => BuildCandlestickChartOption(allSelectedColumns, colors),
                "donut" => BuildDonutChartOption(allSelectedColumns, colors),
                "rose" => BuildRoseChartOption(allSelectedColumns, colors),
                "waterfall" => BuildWaterfallChartOption(allSelectedColumns, colors),
                "barRacing" => BuildBarRacingChartOption(allSelectedColumns, colors),
                _ => null
            };

            if (specialOption != null)
            {
                var specialOptionJson = System.Text.Json.JsonSerializer.Serialize(specialOption);
                await JS.InvokeVoidAsync("eval", $@"
                    var chartDom = document.getElementById('{chartId}');
                    if (chartDom) {{
                        var myChart = echarts.init(chartDom, '{chartTheme}');
                        myChart.setOption({specialOptionJson});
                    }}
                ");
                return; // Don't continue with normal chart building
            }
        }

        int colorIndex = colorOffset;
        Console.WriteLine($"[{chartId}] Starting with colorOffset={colorOffset}, palette has {colors.Count} colors");

        bool usingSparseDataFormat = false;

        // Check if filtering is enabled for each Y-axis
        bool hasY1Filtering = !yAxisAutoScale && (yAxisMin != yAxisMax);
        bool hasY2Filtering = !y2AxisAutoScale && (y2AxisMin != y2AxisMax);

        foreach (var column in y1Columns)
        {
            var values = GetColumnValues(plotData, column, yAxisIndex: 0);
            Console.WriteLine($"[{chartId}] Column '{column}': {values.Count} values, first 5: {string.Join(", ", values.Take(5))}");

            if (values.Count > 0 && values[0] is object[] arr && arr.Length == 2)
            {
                usingSparseDataFormat = true;
            }

            var seriesColor = colors[colorIndex % colors.Count];
            Console.WriteLine($"[{chartId}] Assigning color index {colorIndex} (mod {colorIndex % colors.Count}): {seriesColor} to '{column}'");
            colorIndex++;

            // chartType, isStep, isStacked, showArea already defined above from GetChartTypeProperties()

            var seriesItem = new
            {
                name = column,
                type = chartType,
                data = values,
                yAxisIndex = 0,
                stack = isStacked ? "total" : (string?)null,
                step = isStep ? "middle" : (string?)null,
                barWidth = "50%",
                barCategoryGap = "130px",
                connectNulls = !hasY1Filtering,
                large = values.Count > 10000,
                largeThreshold = 2000,
                showSymbol = performanceMode ? false : showDataPointMarkers,
                symbol = symbolType,
                symbolSize = symbolSize,
                smooth = performanceMode ? false : (isStep ? false : enableSmoothLines),
                animation = performanceMode ? false : true,
                animationDuration = performanceMode ? 0 : animationDuration,
                animationEasing = animationEasing,
                animationDelay = 0,
                lineStyle = new
                {
                    width = defaultLineWidth,
                    type = lineStyle,
                    opacity = lineOpacity / 100.0
                },
                areaStyle = showArea && !performanceMode ? new { opacity = areaOpacity / 100.0 } : null,
                itemStyle = new
                {
                    color = seriesColor,
                    borderColor = "#fff",
                    borderWidth = showDataPointMarkers ? 2 : 0
                },
                sampling = performanceMode ? "lttb" : (showDataPointMarkers ? (object?)null : "lttb"),
                z = showDataPointMarkers ? 10 : 2,
                zlevel = showDataPointMarkers ? 1 : 0,
                label = (showDataLabels && !performanceMode) ? new
                {
                    show = !dataLabelShowOnHighlight,
                    position = dataLabelPosition,
                    color = dataLabelColor,
                    fontSize = dataLabelFontSize,
                    fontWeight = dataLabelFontWeight,
                    backgroundColor = dataLabelBackgroundColor,
                    borderColor = dataLabelBorderColor,
                    borderWidth = dataLabelBorderWidth,
                    borderRadius = dataLabelBorderRadius,
                    padding = dataLabelPadding,
                    formatter = dataLabelFormatter,
                    rotate = dataLabelRotate
                } : null,
                emphasis = showDataLabels && dataLabelShowOnHighlight ? new
                {
                    label = new
                    {
                        show = true,
                        position = dataLabelPosition,
                        color = dataLabelColor,
                        fontSize = dataLabelFontSize,
                        fontWeight = dataLabelFontWeight,
                        backgroundColor = dataLabelBackgroundColor,
                        borderColor = dataLabelBorderColor,
                        borderWidth = dataLabelBorderWidth,
                        borderRadius = dataLabelBorderRadius,
                        padding = dataLabelPadding,
                        formatter = dataLabelFormatter,
                        rotate = dataLabelRotate
                    }
                } : null
            };
            series.Add(seriesItem);
        }

        bool hasY2 = enableY2Axis && y2Columns.Count > 0;
        if (hasY2)
        {
            foreach (var column in y2Columns)
            {
                var values = GetColumnValues(plotData, column, yAxisIndex: 1);
                
                if (values.Count > 0 && values[0] is object[] arr && arr.Length == 2)
                {
                    usingSparseDataFormat = true;
                }

                var seriesColor = colors[colorIndex % colors.Count];
                colorIndex++;

                // chartType, isStep, isStacked, showArea already defined above from GetChartTypeProperties()

                var seriesItem = new
                {
                    name = column,
                    type = chartType,
                    data = values,
                    yAxisIndex = 1,
                    stack = isStacked ? "total2" : (string?)null,
                    step = isStep ? "middle" : (string?)null,
                    connectNulls = !hasY2Filtering,
                    large = values.Count > 10000,
                    largeThreshold = 2000,
                    showSymbol = performanceMode ? false : showDataPointMarkers,
                    symbol = symbolType,
                    symbolSize = symbolSize,
                    smooth = performanceMode ? false : (isStep ? false : enableSmoothLines),
                    animation = performanceMode ? false : true,
                    animationDuration = performanceMode ? 0 : animationDuration,
                    animationEasing = animationEasing,
                    animationDelay = 0,
                    lineStyle = new
                    {
                        width = defaultLineWidth,
                        type = lineStyle,
                        opacity = lineOpacity / 100.0
                    },
                    areaStyle = showArea && !performanceMode ? new { opacity = areaOpacity / 100.0 } : null,
                    itemStyle = new
                    {
                        color = seriesColor,
                        borderColor = "#fff",
                        borderWidth = showDataPointMarkers ? 2 : 0
                    },
                    sampling = performanceMode ? "lttb" : (showDataPointMarkers ? (object?)null : "lttb"),
                    z = showDataPointMarkers ? 10 : 2,
                    zlevel = showDataPointMarkers ? 1 : 0,
                    label = (showDataLabels && !performanceMode) ? new
                    {
                        show = !dataLabelShowOnHighlight,
                        position = dataLabelPosition,
                        color = dataLabelColor,
                        fontSize = dataLabelFontSize,
                        fontWeight = dataLabelFontWeight,
                        backgroundColor = dataLabelBackgroundColor,
                        borderColor = dataLabelBorderColor,
                        borderWidth = dataLabelBorderWidth,
                        borderRadius = dataLabelBorderRadius,
                        padding = dataLabelPadding,
                        formatter = dataLabelFormatter,
                        rotate = dataLabelRotate
                    } : null,
                    emphasis = showDataLabels && dataLabelShowOnHighlight ? new
                    {
                        label = new
                        {
                            show = true,
                            position = dataLabelPosition,
                            color = dataLabelColor,
                            fontSize = dataLabelFontSize,
                            fontWeight = dataLabelFontWeight,
                            backgroundColor = dataLabelBackgroundColor,
                            borderColor = dataLabelBorderColor,
                            borderWidth = dataLabelBorderWidth,
                            borderRadius = dataLabelBorderRadius,
                            padding = dataLabelPadding,
                            formatter = dataLabelFormatter,
                            rotate = dataLabelRotate
                        }
                    } : null
                };
                series.Add(seriesItem);
            }
        }

        Console.WriteLine($"[{chartId}] Using sparse data format: {usingSparseDataFormat}");

        // Check if any series has filtering enabled (Y-axis limits)
        bool hasFiltering = hasY1Filtering || hasY2Filtering;

        // Build tooltip formatter function as JavaScript
        var useScientific = useScientificNotation ? "true" : "false";
        var xAxisLabelsJson = System.Text.Json.JsonSerializer.Serialize(xAxisLabels);
        var sparseFormatFlag = usingSparseDataFormat.ToString().ToLower();
        var tooltipFormatter = $@"
            function(params) {{
                try {{
                    if (!Array.isArray(params)) params = [params];
                    if (!params || params.length === 0) return '';
                    
                    let axisValue = params[0].axisValue;
                    let timeLabel = axisValue;
                    
                    if ({sparseFormatFlag}) {{
                        let xAxisLabels = {xAxisLabelsJson};
                        if (typeof axisValue === 'number') {{
                            let index = Math.round(axisValue);
                            if (index >= 0 && index < xAxisLabels.length) {{
                                timeLabel = xAxisLabels[index];
                            }} else {{
                                timeLabel = axisValue.toString();
                            }}
                        }}
                    }}
                    
                    let result = timeLabel + '<br/>';
                    let hasData = false;
                    params.forEach(function(item) {{
                        if (!item) return;
                        let value = item.value;
                        if (Array.isArray(value)) {{
                            value = value[1];
                        }}
                        if (value === null || value === undefined || isNaN(value)) return;
                        
                        hasData = true;
                        let formatted;
                        if ({useScientific} && (Math.abs(value) >= 1e6 || (Math.abs(value) < 1e-6 && value !== 0))) {{
                            formatted = value.toExponential({decimalPlaces});
                        }} else {{
                            formatted = value.toFixed({decimalPlaces});
                        }}
                        result += item.marker + ' ' + item.seriesName + ': ' + formatted + '<br/>';
                    }});
                    
                    if (!hasData) {{
                        return '';
                    }}
                    return result;
                }} catch(e) {{
                    console.error('Tooltip formatter error:', e);
                    return params[0]?.axisValue || 'Error';
                }}
            }}
        ";

        // Get legend positioning
        object? legendConfig = null;
        if (showLegend)
        {
            switch (legendPosition)
            {
                case "bottom":
                    legendConfig = new
                    {
                        data = series.Select(s => ((dynamic)s).name).ToArray(),
