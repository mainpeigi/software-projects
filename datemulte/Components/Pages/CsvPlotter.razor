    private async Task SaveSession(string name)
    {
        try
        {
            var session = BuildSessionState(includeData: true);
            session.Name = name;
            session.Id = Guid.NewGuid().ToString();
            session.CreatedAt = DateTime.Now;
            session.LastModified = DateTime.Now;

            var includeData = data.Count <= 100000;

            if(!includeData && !string.IsNullOrEmpty(rawCsvText))
            {
                await SessionStorage.SaveFileAsync(session.Id, session.FileName ?? "data.csv", rawCsvText);
                session.HasStoredFile = true;
                session.Data = new List<GenericCsvRow>();
                statusMessage = $"Session '{name}' saved with file reference (large dataset).";
            }
            else
            {
                session.HasStoredFile = false;
                if(!includeData)
                {
                    session.Data = new List<GenericCsvRow>();
                    statusMessage = $"Session '{name}' saved (settings only, {data.Count:N0} rows). Reload CSV file after session.";
                }
                else
                {
                    statusMessage = $"Session '{name}' saved successfully with data.";
                }
            }

            await SessionStorage.SaveSessionAsync(session);
            await LoadSessionList();
        }
        catch(Exception ex)
        {
            statusMessage = $"Error saving session: {ex.Message}";
            Console.WriteLine($"SaveSessionAs error: {ex}");
        }
    }
    private async Task SaveSessionAs()
    {
        if (string.IsNullOrWhiteSpace(newSessionName)) return;

        if (data.Count == 0)
        {
            statusMessage = "No data to save. Please load a file first.";
            return;
        }

        if (selectedFile == null && currentSessionId == null)
        {
            statusMessage = "No file loaded. Please load a file first.";
            return;
        }

        try
        {
            statusMessage = $"Saving session '{newSessionName}'...";
            StateHasChanged();

            // If no session exists, create a new one
            if (currentSessionId == null && selectedFile != null)
            {
                var userId = AuthService.CurrentUserId ?? Guid.NewGuid();
                var (sessionId, _) = await DataSessionService.ProcessFileUploadAsync(
                    selectedFile, userId, selectedSheet
                );
                currentSessionId = sessionId;
                
                // Set the session in state service to ensure session-specific localStorage
                StateService.SetCurrentSession(sessionId);
                
                Console.WriteLine($"New session created: {sessionId}");
            }

            // Update the session name in the database
            if (currentSessionId != null)
            {
                await DataSessionService.UpdateSessionNameAsync(currentSessionId.Value, newSessionName, AuthService.CurrentUserId);

                // Save UI state (appearance settings, column selections, etc.)
                var uiState = BuildSessionUIState(currentSessionId.Value);
                await DataSessionService.SaveSessionUIStateAsync(uiState, AuthService.CurrentUserId);

                statusMessage = $"Session '{newSessionName}' saved successfully!";
            }

            newSessionName = "";
            await LoadSessionList();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving session: {ex.Message}";
            Console.WriteLine($"SaveSessionAs error: {ex}");
            StateHasChanged();
        }
    }

    private async Task CreateMultiplayerSession(string sessionName)
    {
        try
        {
            if (data.Count == 0)
            {
                statusMessage = "No data loaded. Please load a file first.";
                StateHasChanged();
                return;
            }

            statusMessage = $"Creating collaborative session '{sessionName}'...";
            StateHasChanged();

            var userId = AuthService.CurrentUserId ?? Guid.NewGuid();

            // Create session from already-loaded data
            var sessionId = await DataSessionService.CreateSessionFromDataAsync(
                data,
                availableColumns,
                numericColumns,
                timeColumn,
                columnUnits,
                columnToGroupMapping,
                sensorGroups,
                sessionName,
                lastLoadedFileName ?? "Untitled",
                userId
            );

            currentSessionId = sessionId;

            // Set the session in state service
            StateService.SetCurrentSession(sessionId);

            // Save initial UI state
            var uiState = BuildSessionUIState(sessionId);
            await DataSessionService.SaveSessionUIStateAsync(uiState, AuthService.CurrentUserId);

            await LoadSessionList();

            statusMessage = $"Collaborative session '{sessionName}' created! You can now share and collaborate.";
            Console.WriteLine($"Multiplayer session created: {sessionId}, currentSessionId set: {currentSessionId}");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            statusMessage = $"Error creating session: {ex.Message}";
            Console.WriteLine($"CreateMultiplayerSession error: {ex}");
            StateHasChanged();
        }
    }

    private async Task LoadSessionList()
    {
        try
        {
            // For now, get all sessions (until user authentication is implemented)
            var sessions = await DataSessionService.GetAllSessionsAsync(AuthService.CurrentUserId);

            savedSessions = sessions.Select(s => new SessionSummary
            {
                Id = s.SessionId.ToString(),
                Name = s.SessionName,
                LastModified = s.LastModifiedAt,
                FileName = s.SourceFileName
            }).ToList();

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session list: {ex.Message}");
            statusMessage = $"Error loading sessions: {ex.Message}";
            savedSessions = new List<SessionSummary>();
        }
    }

    private SessionUIState BuildSessionUIState(Guid sessionId)
    {
