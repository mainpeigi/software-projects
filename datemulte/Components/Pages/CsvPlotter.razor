    private async Task LoadSession(string id)
    {
        try
        {
            Console.WriteLine($"Loading session: {id}");

            if (!Guid.TryParse(id, out var sessionId))
            {
                statusMessage = "Invalid session ID.";
                return;
            }

            statusMessage = "Loading session from database...";
            StateHasChanged();

            var (session, sessionData) = await DataSessionService.LoadSessionAsync(sessionId, AuthService.CurrentUserId);

            if (session == null || sessionData == null)
            {
                statusMessage = "Session not found.";
                return;
            }

            // Clear current state before loading new session
            selectedFile = null;
            newSessionName = "";
            calculationCache.Clear();

            // Update current session tracking
            currentSessionId = sessionId;

            // Set the session in state service to ensure session-specific localStorage
            StateService.SetCurrentSession(sessionId);

            // Restore the data
            data = sessionData;
            availableColumns = session.Columns ?? new List<string>();
            numericColumns = session.NumericColumns ?? new List<string>();
            timeColumn = session.TimeColumn;
            columnUnits = session.ColumnUnits ?? new Dictionary<string, string>();
            columnToGroupMapping = session.ColumnToGroupMapping ?? new Dictionary<string, string>();
            sensorGroups = session.SensorGroups ?? new List<string>();

            // Load and apply UI state (appearance settings, column selections, etc.)
            var uiState = await DataSessionService.LoadSessionUIStateAsync(sessionId, AuthService.CurrentUserId);
            if (uiState != null)
            {
                ApplySessionUIState(uiState);
                Console.WriteLine($"Applied UI state for session {sessionId}");
            }
            else
            {
                // No saved UI state - reset to defaults
                Console.WriteLine($"No UI state found for session {sessionId}, using defaults");
                selectedColumnsY1.Clear();
                selectedColumnsY2.Clear();
                var preferences = await PreferencesService.LoadAsync();
                samplingLevel = preferences.DefaultSamplingLevel;
                chartLayout = preferences.DefaultChartLayout;
            }

            // Update UI
            fileLoaded = true;
            lastLoadedFileName = session.SourceFileName ?? "Unknown";

            // Set session name for display/editing
            newSessionName = session.SessionName;

            statusMessage = $"Session '{session.SessionName}' loaded successfully with {sessionData.Count:N0} rows from database!";

            UpdateChart();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadSession: {ex.Message}");
            statusMessage = $"Error loading session: {ex.Message}";
        }
    }

    private async Task LoadSessionAndClose(string id)
    {
        try
        {
            Console.WriteLine($"LoadSessionAndClose called with ID: {id}");
            await LoadSession(id);
            showSessionManager = false;
            StateHasChanged();
            Console.WriteLine("Session loaded and dialog closed");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading session: {ex.Message}");
            statusMessage = $"Error loading session: {ex.Message}";
        }
    }

    private void CloseSessionManager()
    {
        showSessionManager = false;
