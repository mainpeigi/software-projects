    private async Task LoadSelectedSheet()
    {
        if (selectedSheet == null || pendingExcelFile == null)
        {
            statusMessage = "Please select a sheet";
            return;
        }

        try
        {
            Console.WriteLine($"Loading Excel sheet: {selectedSheet}");
            _parseCts.Cancel();
            _parseCts = new CancellationTokenSource();
            var ct = _parseCts.Token;

            isLoading = true;
            statusMessage = $"Reading sheet '{selectedSheet}'...";
            StateHasChanged();

            lastLoadedFileName = $"{pendingExcelFile.Name} - {selectedSheet}";
            lastLoadedFileTimestamp = DateTime.Now;
            lastLoadedFileSize = pendingExcelFile.Size;

            // Set the current file and load any previously saved state for this file
            var savedState = await StateService.SetCurrentFileAndLoadStateAsync(lastLoadedFileName);

            using var stream = pendingExcelFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            Console.WriteLine("Parsing Excel sheet...");

            var excelProgress = new Progress<int>(rows =>
                InvokeAsync(() => { statusMessage = $"Parsing... {rows:N0} rows read"; StateHasChanged(); }));
            var result = await CsvService.ParseExcelSheetAsync(stream, selectedSheet, excelProgress, ct);

            if (enableLazyLoading && result.data.Count > 100000)
            {
                statusMessage = $"Processing {result.data.Count:N0} rows in chunks...";
                StateHasChanged();
                await Task.Delay(100);
            }

            data = result.data;
            availableColumns = result.numericColumns;
            numericColumns = result.numericColumns;
            timeColumn = result.timeColumn;
            columnToGroupMapping = result.columnGroups;
            sensorGroups = result.sensorGroups;

            // Store units from Excel file
            columnUnits = result.columnUnits;
            Console.WriteLine($"Loaded {result.columnUnits.Count} column units from the Excel file");

            // Restore previously saved selections for this file, or start fresh
            if (savedState != null)
            {
                // Only restore columns that still exist in the file
                selectedColumnsY1 = new HashSet<string>(savedState.SelectedColumnsY1.Where(c => numericColumns.Contains(c)));
                selectedColumnsY2 = new HashSet<string>(savedState.SelectedColumnsY2.Where(c => numericColumns.Contains(c)));
                chartLayout = savedState.ChartLayout;
                splitLevel = savedState.SplitLevel;
                enableY2Axis = savedState.EnableY2Axis;
                chartAssignments = savedState.ChartAssignments
                    .Where(kv => numericColumns.Contains(kv.Key))
                    .ToDictionary(kv => kv.Key, kv => kv.Value);
                samplingLevel = savedState.SamplingLevel;
                
                // Restore column units from saved state (merge with file units, file takes precedence)
                foreach (var unit in savedState.ColumnUnits)
                {
                    if (!columnUnits.ContainsKey(unit.Key))
                    {
                        columnUnits[unit.Key] = unit.Value;
                    }
                }
                
                Console.WriteLine($"Restored saved settings for file: {selectedColumnsY1.Count} Y1 columns, {selectedColumnsY2.Count} Y2 columns");
            }
            else
            {
                selectedColumnsY1.Clear();
                selectedColumnsY2.Clear();
                
                var preferences = await PreferencesService.LoadAsync();
                samplingLevel = preferences.DefaultSamplingLevel;
                chartLayout = preferences.DefaultChartLayout;
            }
            
            calculationCache.Clear();

            // Auto-detect units for columns that don't have units from the Excel file
            AutoDetectColumnUnits();

            // Store all detected units (from CSV + auto-detected) for the dialog
            detectedColumnUnits = new Dictionary<string, string>(columnUnits);
            Console.WriteLine($"Total detected units (CSV + auto): {detectedColumnUnits.Count}");

            rangeStartPoint = 0;
            rangeEndPoint = Math.Min(data.Count - 1, rangeStartPoint + MAX_RANGE_SIZE);

            Console.WriteLine($"Loaded {data.Count} records with {numericColumns.Count} numeric columns");
            Console.WriteLine($"Time column detected: {timeColumn ?? "None"}");
            Console.WriteLine($"Numeric columns: {string.Join(", ", numericColumns)}");

            if (data.Count > 0)
            {
                var firstRow = data[0];
                Console.WriteLine($"First row sample:");
                foreach (var col in numericColumns.Take(3))
                {
                    Console.WriteLine($"  {col} = '{firstRow.GetValue(col)}'");
                }
            }

            statusMessage = $"Loaded {data.Count:N0} records with {numericColumns.Count} numeric columns from sheet '{selectedSheet}'!";
            showSheetSelector = false;
            isLoading = false;
            SaveCurrentState();
            StateHasChanged();

            // Check for zero values asynchronously after UI update
            _ = CheckForZeroValuesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            statusMessage = $"Error: {ex.Message}";
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCsvData()
    {
        Console.WriteLine("LoadCsvData called");
        Console.WriteLine($"selectedFile is null: {selectedFile == null}");

        if (selectedFile == null) return;

        try
        {
            Console.WriteLine("Starting to load file...");
            _parseCts.Cancel();
            _parseCts = new CancellationTokenSource();
            var ct = _parseCts.Token;

            isLoading = true;
            statusMessage = "Reading file...";
            StateHasChanged();

            lastLoadedFileName = selectedFile.Name;
            lastLoadedFileTimestamp = DateTime.Now;
            lastLoadedFileSize = selectedFile.Size;

            // Set the current file and load any previously saved state for this file
            var savedState = await StateService.SetCurrentFileAndLoadStateAsync(selectedFile.Name);

            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 500 * 1024 * 1024);
            Console.WriteLine("Parsing file...");

            var csvProgress = new Progress<int>(rows =>
                InvokeAsync(() => { statusMessage = $"Parsing... {rows:N0} rows read"; StateHasChanged(); }));
            var result = await CsvService.ParseGenericCsvAsync(stream, autoDetectDateColumns, csvProgress, ct);

            if (enableLazyLoading && result.data.Count > 100000)
            {
                statusMessage = $"Processing {result.data.Count:N0} rows in chunks...";
                StateHasChanged();
                await Task.Delay(100);
            }

            data = result.data;
            availableColumns = result.numericColumns;
            numericColumns = result.numericColumns;
            timeColumn = result.timeColumn;
            columnToGroupMapping = result.columnGroups;
            sensorGroups = result.sensorGroups;

            columnUnits = result.columnUnits;
            Console.WriteLine($"Loaded {result.columnUnits.Count} column units from CSV file");

            // Restore previously saved selections for this file, or start fresh
            if (savedState != null)
            {
                // Only restore columns that still exist in the file
                selectedColumnsY1 = new HashSet<string>(savedState.SelectedColumnsY1.Where(c => numericColumns.Contains(c)));
                selectedColumnsY2 = new HashSet<string>(savedState.SelectedColumnsY2.Where(c => numericColumns.Contains(c)));
                chartLayout = savedState.ChartLayout;
                splitLevel = savedState.SplitLevel;
                enableY2Axis = savedState.EnableY2Axis;
                chartAssignments = savedState.ChartAssignments
                    .Where(kv => numericColumns.Contains(kv.Key))
                    .ToDictionary(kv => kv.Key, kv => kv.Value);
                samplingLevel = savedState.SamplingLevel;
                
                // Restore column units from saved state (merge with file units, file takes precedence)
                foreach (var unit in savedState.ColumnUnits)
                {
                    if (!columnUnits.ContainsKey(unit.Key))
                    {
                        columnUnits[unit.Key] = unit.Value;
                    }
                }
                Console.WriteLine($"Restored saved settings for file: {selectedColumnsY1.Count} Y1 columns, {selectedColumnsY2.Count} Y2 columns");
            }
            else
            {
                selectedColumnsY1.Clear();
                selectedColumnsY2.Clear();

                var preferences = await PreferencesService.LoadAsync();
                samplingLevel = preferences.DefaultSamplingLevel;
                chartLayout = preferences.DefaultChartLayout;
            }

            // Auto-load UI settings from database if a previous session exists for this file
            var existingSession = await DataSessionService.FindLatestSessionByFileNameAsync(selectedFile.Name, AuthService.CurrentUserId);
            if (existingSession != null)
            {
                var savedUIState = await DataSessionService.LoadSessionUIStateAsync(existingSession.SessionId, AuthService.CurrentUserId);
                if (savedUIState != null)
                {
                    ApplySessionUIState(savedUIState);
                    statusMessage = $"Auto-loaded settings from session: {existingSession.SessionName}";
                    Console.WriteLine($"Auto-loaded UI state from session {existingSession.SessionId}");
                }
            }
            
            calculationCache.Clear();

            // Auto-detect units for columns that don't have units from the CSV
            AutoDetectColumnUnits();

            // Store all detected units (from CSV + auto-detected) for the dialog
            detectedColumnUnits = new Dictionary<string, string>(columnUnits);
            Console.WriteLine($"Total detected units (CSV + auto): {detectedColumnUnits.Count}");

            rangeStartPoint = 0;
            rangeEndPoint = Math.Min(data.Count - 1, rangeStartPoint + MAX_RANGE_SIZE);

            Console.WriteLine($"Loaded {data.Count} records with {numericColumns.Count} numeric columns");
            Console.WriteLine($"Time column detected: {timeColumn ?? "None"}");
            Console.WriteLine($"All columns: {string.Join(", ", result.columns)}");
            Console.WriteLine($"Numeric columns: {string.Join(", ", numericColumns)}");

            if (data.Count > 0)
            {
                var firstRow = data[0];
                Console.WriteLine($"First row sample:");
                foreach (var col in numericColumns.Take(3))
                {
                    Console.WriteLine($"  {col} = '{firstRow.GetValue(col)}'");
                }
            }

            statusMessage = $"Loaded {data.Count:N0} records with {numericColumns.Count} numeric columns!";
            isLoading = false;
            fileLoaded = true;
            SaveCurrentState();
            StateHasChanged();

            // Check for zero values asynchronously after UI update
            _ = CheckForZeroValuesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            statusMessage = $"Error: {ex.Message}";
            isLoading = false;
            StateHasChanged();
        }
    }

