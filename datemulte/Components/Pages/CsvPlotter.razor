    {
        if (firstRender && !_isInitialized)
        {
            _isInitialized = true;
        await LoadPreferences();
        await RestoreStateAsync();

            // Disable browser context menu on chart
            await JS.InvokeVoidAsync("eval", @"
                document.addEventListener('contextmenu', function(e) {
                    const chart = document.getElementById('chart');
                    if (chart && chart.contains(e.target)) {
                        e.preventDefault();
                    }
                });
            ");
            await JS.InvokeVoidAsync("setupDropZone", "fileDropZone", "csvFileInput");

            // Load session from URL parameter if provided
