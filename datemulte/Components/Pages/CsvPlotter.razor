    }

    private async Task DeleteSession(string id)
    {
        try
        {
            if (!Guid.TryParse(id, out var sessionId))
            {
                statusMessage = "Invalid session ID.";
                return;
            }

            // Clean up session-specific localStorage
            await StateService.ClearSessionStateAsync(sessionId);

            await DataSessionService.DeleteSessionAsync(sessionId, AuthService.CurrentUserId);
            
            // If we deleted the current session, clear the tracking
            if (currentSessionId == sessionId)
            {
                currentSessionId = null;
                StateService.SetCurrentSession(null);
            }
            
            await LoadSessionList();
            statusMessage = "Session deleted successfully.";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting session: {ex.Message}");
            statusMessage = $"Error deleting session: {ex.Message}";
        }
    }

    private List<GenericCsvRow> ApplyFilters(List<GenericCsvRow> sourceData)
    {
        if (activeFilters.Count == 0 || !activeFilters.Any(f => f.IsEnabled))
        {
            return sourceData;
        }

        var result = sourceData.ToList();

        foreach (var filter in activeFilters.Where(f => f.IsEnabled))
        {
            if (filter.Operator == "even")
            {
                result = result.Where(row =>
                {
                    var cellValue = row.GetNumericValueOrNull(filter.Column);
                    if (cellValue == null) return false;
                    return (int)(double)cellValue % 2 == 0;
                }).ToList();
            }
            else if (filter.Operator == "odd")
            {
                result = result.Where(row =>
                {
                    var cellValue = row.GetNumericValueOrNull(filter.Column);
                    if (cellValue == null) return false;
                    return (int)(double)cellValue % 2 != 0;
                }).ToList();
            }
            else if (filter.Operator == "increasing")
            {
                var filtered = new List<GenericCsvRow>();
                double? prevValue = null;
                foreach (var row in result)
                {
                    var cellValue = row.GetNumericValueOrNull(filter.Column);
                    if (cellValue == null) continue;
                    double val = (double)cellValue;
                    if (prevValue == null || val > prevValue)
                    {
                        filtered.Add(row);
                    }
                    prevValue = val;
                }
                result = filtered;
            }
            else if (filter.Operator == "decreasing")
            {
                var filtered = new List<GenericCsvRow>();
                double? prevValue = null;
                foreach (var row in result)
                {
                    var cellValue = row.GetNumericValueOrNull(filter.Column);
                    if (cellValue == null) continue;
                    double val = (double)cellValue;
                    if (prevValue == null || val < prevValue)
                    {
                        filtered.Add(row);
                    }
                    prevValue = val;
                }
                result = filtered;
            }
            else
            {
                if (!double.TryParse(filter.Value, out double filterValue))
                    continue;

                result = result.Where(row =>
                {
                    var cellValue = row.GetNumericValueOrNull(filter.Column);
                    if (cellValue == null) return false;
                    double val = (double)cellValue;

                    return filter.Operator switch
                    {
                        ">" => val > filterValue,
                        "<" => val < filterValue,
                        ">=" => val >= filterValue,
                        "<=" => val <= filterValue,
                        "==" => Math.Abs(val - filterValue) < 0.0001,
                        "!=" => Math.Abs(val - filterValue) >= 0.0001,
                        _ => true
                    };
                }).ToList();
            }
        }

        return result;
    }
