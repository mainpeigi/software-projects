    <script>
        (function() {
            function random(min, max) {
                return Math.random() * (max - min) + min;
            }

            function randomInt(min, max) {
                return Math.floor(Math.random() * (max - min + 1)) + min;
            }

            const particlesContainer = document.querySelector('.particles-bg');
            const particleCount = randomInt(8, 20);
            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                const size = random(2, 8);
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                particle.style.top = random(0, 100) + '%';
                particle.style.left = random(0, 100) + '%';
                particle.style.animationDelay = random(0, 2) + 's';
                particle.style.animationDuration = random(6, 12) + 's';
                
                const tx = random(-200, 200);
                const ty = random(-200, 200);
                const scale = random(0.8, 1.5);
                const rotate = random(0, 360);
                particle.style.setProperty('--tx', tx + 'px');
                particle.style.setProperty('--ty', ty + 'px');
                particle.style.setProperty('--scale', scale);
                particle.style.setProperty('--rotate', rotate + 'deg');
                
                particlesContainer.appendChild(particle);
            }
            /*
            const lightBeamsContainer = document.querySelector('.light-beams');
            const beamCount = randomInt(2, 5);
            for (let i = 0; i < beamCount; i++) {
                const beam = document.createElement('div');
                beam.className = 'light-beam';
                beam.style.left = random(10, 90) + '%';
                beam.style.animationDelay = random(0, 2) + 's';
                beam.style.animationDuration = random(3, 5) + 's';
                lightBeamsContainer.appendChild(beam);
            }
            */
            const orbsContainer = document.querySelector('.glowing-orbs');
            const orbCount = randomInt(3, 6);
            for (let i = 0; i < orbCount; i++) {
                const orb = document.createElement('div');
                orb.className = 'orb puffIn';
                const size = random(60, 130);
                orb.style.width = size + 'px';
                orb.style.height = size + 'px';
                orb.style.top = random(10, 85) + '%';
                orb.style.left = random(5, 90) + '%';
                orb.style.animationDelay = random(0, 2) + 's';
                orb.style.animationDuration = random(5, 8) + 's';
                
                const tx = random(-60, 60);
                const ty = random(-80, 80);
                const scale = random(0.85, 1.15);
                orb.style.setProperty('--tx', tx + 'px');
                orb.style.setProperty('--ty', ty + 'px');
                orb.style.setProperty('--scale', scale);
                
                orbsContainer.appendChild(orb);
            }

            const shapesContainer = document.querySelector('.geometric-shapes');
            const shapeTypes = ['circle', 'triangle', 'square', 'hexagon', 'diamond'];
            const shapeCount = randomInt(4, 8);
            for (let i = 0; i < shapeCount; i++) {
                const shapeType = shapeTypes[randomInt(0, shapeTypes.length - 1)];
                const shape = document.createElement('div');
                shape.className = 'shape shape-' + shapeType;
                shape.style.top = random(10, 85) + '%';
                shape.style.left = random(10, 85) + '%';
                shape.style.animationDelay = random(0, 3) + 's';
                shape.style.animationDuration = random(10, 18) + 's';
                
                const tx = random(-150, 150);
                const ty = random(-150, 150);
                const rotate = random(0, 360);
                const scale = random(0.6, 1.3);
                shape.style.setProperty('--tx', tx + 'px');
                shape.style.setProperty('--ty', ty + 'px');
                shape.style.setProperty('--rotate', rotate + 'deg');
                shape.style.setProperty('--scale', scale);
                
                shapesContainer.appendChild(shape);
            }
        })();

        window.addEventListener('DOMContentLoaded', function(){
            const percentageEl = document.querySelector('.loading-percentage');
            if(percentageEl){
                let count = 0;
                const interval = setInterval(()=>{
                    count += Math.floor(Math.random()*3)+1;
                    if(count>=100)
                    {
                        count=100;
                        clearInterval(interval);
                    }
                    percentageEl.textContent = count + '%';
                },50);
            }
        });
    </script>
    <script src="_framework/blazor.web.js"></script>
    <script src="lib/echarts/echarts.min.js"></script>
    <script>
        // Wait for echarts to be loaded
        window.waitForEcharts = function(callback, errorCallback, maxAttempts = 50) {
            var attempts = 0;
            var checkEcharts = function() {
                attempts++;
                if (typeof echarts !== 'undefined') {
                    callback();
                } else if (attempts < maxAttempts) {
                    setTimeout(checkEcharts, 100);
                } else {
                    console.error('ECharts failed to load after ' + (maxAttempts * 100) + 'ms');
                    if (errorCallback) {
                        errorCallback('ECharts failed to load after ' + (maxAttempts * 100) + 'ms');
                    }
                }
            };
            checkEcharts();
        };
    </script>
    <!-- ECharts Themes -->
    <script src="lib/echarts/vintage.js"></script>
