        }
    </style>
    <script>
        (function() {
            if (typeof echarts !== 'undefined') {
                setTimeout(function() {
                    // Dark mode base settings
                    var darkBase = {
                        backgroundColor: 'rgba(15, 23, 42, 0)',
                        textStyle: { color: '#e2e8f0' },
                        title: {
                            textStyle: { color: '#e2e8f0' },
                            subtextStyle: { color: '#cbd5e1' }
                        },
                        legend: {
                            textStyle: { color: '#e2e8f0' }
                        },
                        categoryAxis: {
                            axisLine: { lineStyle: { color: '#64748b' } },
                            axisTick: { lineStyle: { color: '#64748b' } },
                            axisLabel: { color: '#cbd5e1' },
                            splitLine: { lineStyle: { color: ['#334155'] } }
                        },
                        valueAxis: {
                            axisLine: { lineStyle: { color: '#64748b' } },
                            axisTick: { lineStyle: { color: '#64748b' } },
                            axisLabel: { color: '#cbd5e1' },
                            splitLine: { lineStyle: { color: ['#334155'] } }
                        },
                        timeAxis: {
                            axisLine: { lineStyle: { color: '#64748b' } },
                            axisTick: { lineStyle: { color: '#64748b' } },
                            axisLabel: { color: '#cbd5e1' },
                            splitLine: { lineStyle: { color: ['#334155'] } }
                        },
                        logAxis: {
                            axisLine: { lineStyle: { color: '#64748b' } },
                            axisTick: { lineStyle: { color: '#64748b' } },
                            axisLabel: { color: '#cbd5e1' },
                            splitLine: { lineStyle: { color: ['#334155'] } }
                        },
                        toolbox: {
                            iconStyle: { borderColor: '#cbd5e1' },
                            emphasis: { iconStyle: { borderColor: '#e2e8f0' } }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(30, 41, 59, 0.95)',
                            borderColor: '#475569',
                            textStyle: { color: '#e2e8f0' },
                            axisPointer: {
                                lineStyle: { color: '#cbd5e1' },
                                crossStyle: { color: '#cbd5e1' }
                            }
                        },
                        dataZoom: {
                            backgroundColor: 'rgba(30, 41, 59, 0.5)',
                            fillerColor: 'rgba(100, 116, 139, 0.2)',
                            handleStyle: { color: '#cbd5e1' },
                            dataBackground: { lineStyle: { color: '#475569' } },
                            textStyle: { color: '#e2e8f0' }
                        }
                    };

                    // Theme color palettes (from official ECharts themes)
                    var themeColors = {
                        'vintage': ['#d87c7c', '#919e8b', '#d7ab82', '#6e7074', '#61a0a8', '#efa18d', '#787464', '#cc7e63', '#724e58', '#4b565b'],
                        'macarons': ['#2ec7c9', '#b6a2de', '#5ab1ef', '#ffb980', '#d87a80', '#8d98b3', '#e5cf0d', '#97b552', '#95706d', '#dc69aa'],
                        'infographic': ['#c1232b', '#27727b', '#fcce10', '#e87c25', '#b5c334', '#fe8463', '#9bca63', '#fad860', '#f3a43b', '#60c0dd'],
                        'shine': ['#c12e34', '#e6b600', '#0098d9', '#2b821d', '#005eaa', '#339ca8', '#cda819', '#32a487'],
                        'roma': ['#e01f54', '#001852', '#f5e8c8', '#b8d2c7', '#c6b38e', '#a4d8c2', '#f3d999', '#d3758f', '#dcc392', '#2e4783']
                    };

                    // Register each dark theme with its unique color palette
                    Object.keys(themeColors).forEach(function(themeName) {
                        var theme = JSON.parse(JSON.stringify(darkBase));
                        theme.color = themeColors[themeName];
                        echarts.registerTheme(themeName + '-dark', theme);
                    });
                }, 100);
            }
        })();
    </script>
