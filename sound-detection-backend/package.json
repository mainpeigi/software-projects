    "demo": "npm run build && node dist/demo.js",
    "test": "vitest run --maxWorkers=2"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
